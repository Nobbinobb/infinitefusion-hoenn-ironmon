<Window x:Class="Ironmon.Tracker.AchievementOverlay.OverlayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement notification" Width="348" Height="64" Left="-32000" Top="-32000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
        IsHitTestVisible="False" ResizeMode="NoResize" UseLayoutRounding="True">
    <Viewbox Stretch="Fill">
      <Grid Width="348" Height="64" ClipToBounds="True">
       <Canvas Width="348" Height="64">
        <Grid Width="340" Height="64" x:Name="PanelContent">
            <Border BorderBrush="#BF43576A" BorderThickness="1" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#BF1A2835" Offset="0" />
                        <GradientStop Color="#BF131A24" Offset="0.225" />
                        <GradientStop Color="#BF131A24" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Image x:Name="Badge" Width="50" Height="50" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="Fill" SnapsToDevicePixels="True" />
            <Rectangle Fill="#BF456779" Width="1" Height="40" Margin="63,12,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
            <TextBlock x:Name="AchievementTitle" Margin="77,0,14,0" MaxHeight="44" VerticalAlignment="Center"
                       Foreground="#FFF5F8FC" FontFamily="Arial" FontSize="20" FontWeight="Bold"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="22" LineStackingStrategy="BlockLineHeight" />
        </Grid>
       </Canvas>
      </Grid>
    </Viewbox>
</Window>
