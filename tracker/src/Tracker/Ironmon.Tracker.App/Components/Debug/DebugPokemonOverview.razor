<article class="debug-overview" aria-label="@Text["Debug.Overview.InspectedPokemonOverview"]">


    <section class="debug-data-section tools-panel tools-identity-data">
        <p class="section-label">@Text["Debug.Overview.IdentityHeading"]</p>
        <dl class="debug-data-grid">
            <div><dt>@Text["Debug.Overview.Item"]</dt><dd>@(Pokemon.HeldItemName ?? Text["Debug.Overview.None"])</dd></div>
            <div><dt>@Text["Debug.Overview.Form"]</dt><dd>@GetFormText()</dd></div>

            <div><dt>@Text["Debug.Overview.PokemonId"]</dt><dd>@Pokemon.PokemonId</dd></div>
            <div><dt>@Text["Debug.Overview.SpeciesId"]</dt><dd>@Pokemon.SpeciesId</dd></div>
            <div><dt>@Text["Debug.Overview.AbilitySlot"]</dt><dd>@Pokemon.ActiveAbilitySlot (@Pokemon.ActiveAbilityIndex)</dd></div>
            <div><dt>@Text["Debug.Overview.Ability"]</dt><dd>@Pokemon.ActiveAbilityName · @Pokemon.ActiveAbilityId</dd></div>
        </dl>
    </section>

</article>
