@if (GetVisibleGroups().Count > 1)
{
    <nav class="research-group-tabs" aria-label="@Text["Debug.Abilities.InspectedAbilitySlots"]">
        @foreach (DebugAbilitySlotGroup group in GetVisibleGroups())
        {
            <button type="button" aria-pressed="@(SelectedGroup == group ? "true" : "false")" @onclick="() => _selectedGroup = group">@(group == DebugAbilitySlotGroup.FinalFusion ? Text["Redesign.Research.FinalFusion"] : GetGroupName(group))</button>
        }
    </nav>
}
@if (Slots.Count > 0)
{
    <ObsidianSection Title="@GetGroupName(SelectedGroup)" Icon="ObsidianIconKind.Layers" Class="research-abilities">
        <HeadingContent><small>@Text["Debug.Abilities.SlotCount", GetSlots(SelectedGroup).Count]</small></HeadingContent>
        <ChildContent>
            @foreach (DebugAbilitySlotSnapshot slot in GetSlots(SelectedGroup))
            {
                <article class="research-ability-slot">
                    <div class="research-slot-heading"><span>@GetSlotName(slot)</span><span>@GetEligibilityName(slot.Eligibility)</span></div>
                    <button type="button" class="research-ability-name" @onclick="() => SelectSlotAsync(slot)">@slot.AbilityName <span aria-hidden="true">↗</span></button>
                    @if (slot.Active)
                    {
                        <span class="research-active">@Text["Debug.Abilities.ActiveHeading"]</span>
                    }
                    <dl>
                        @if (slot.OriginalAbilityName is not null)
                        {
                            <div><dt>@Text["Debug.Abilities.Original"]</dt><dd>@slot.OriginalAbilityName</dd></div>
                        }
                        @if (slot.Source is not null)
                        {
                            <div><dt>@Text["Debug.Abilities.Source"]</dt><dd>@slot.Source</dd></div>
                        }
                        @if (slot.SourceAbilityName is not null)
                        {
                            <div><dt>@Text["Debug.Abilities.From"]</dt><dd>@slot.SourceAbilityName</dd></div>
                        }
                    </dl>
                    @if (slot.RestrictedSourceReplaced)
                    {
                        <p class="research-note">@Text["Debug.Abilities.RestrictedAbilityReplaced"]</p>
                    }
                </article>
            }
        </ChildContent>
    </ObsidianSection>
}
