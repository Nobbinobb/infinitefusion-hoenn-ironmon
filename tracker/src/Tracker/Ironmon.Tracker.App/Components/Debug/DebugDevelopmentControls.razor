<section class="development-controls" aria-label="@Text["Development.Title"]" aria-busy="@(_loading ? "true" : "false")">
    <header class="tools-page-heading">
        <h3>@Text["Development.Title"]</h3>
        <button type="button" class="obsidian-button" disabled="@(_loading || _evolutionsLoading)" @onclick="LoadAsync"><ObsidianIcon Kind="ObsidianIconKind.Reset" />@Text["Development.Refresh"]</button>
    </header>
    @if (_error is not null)
    {
        <p class="lookup-error" role="alert">@_error</p>
    }
    @if (_notice is not null)
    {
        <p class="tools-notice" role="status">@_notice</p>
    }
    @if (_state is null)
    {
        <p class="lookup-message">@Text["Development.Loading"]</p>
    }
    else
    {
        @if (_state.Player is null)
        {
            <p class="lookup-message">@Text["Redesign.Tools.NoPlayer"]</p>
        }
        @if (CanAutoRevive || CanFullHeal || CanLevel || CanAbility)
        {
            <section class="tools-panel tools-player-controls">
                @if (CanAutoRevive || CanFullHeal)
                {
                    <div class="tools-quick-actions">
                        @if (CanAutoRevive)
                        {
                            <ObsidianToggle Class="tools-toggle" Label="@Text["Development.AutoRevive.ShortLabel"]" Value="_state.AutoReviveEnabled" ValueChanged="SetAutoReviveAsync" Disabled="_loading" />
                        }
                        @if (CanFullHeal)
                        {
                            <button type="button" class="obsidian-button tools-heal" disabled="@(_loading || _state.Player is null)" @onclick="FullHealAsync"><ObsidianIcon Kind="ObsidianIconKind.Heart" />@Text["Development.FullHeal.CompactAction"]</button>
                        }
                    </div>
                }
                @if (CanAbility || CanLevel)
                {
                    <div class="tools-player-fields">
                        @if (CanAbility)
                        {
                            <div class="tools-ability"><span class="tools-field-label">@Text["Development.Ability.Label"]</span><DevelopmentCatalogPicker Options="@_state.Abilities" SelectedId="@_abilityId" SelectedIdChanged="SetAbilitySelectionAsync" ClearSelectionOnInput="false" Placeholder="@Text["Development.Ability.Search"]" AriaLabel="@Text["Development.Ability.Title"]" EmptyText="@Text["Development.NoMatches"]" Disabled="@(_loading || _state.Player is null)" /></div>
                        }
                        @if (CanLevel)
                        {
                            <label class="tools-level"><span class="tools-field-label">@Text["Development.Level.Label"]</span><input type="number" min="1" max="100" @bind="_level" @onblur="SetLevelAsync" disabled="@(_loading || _state.Player is null)" @onkeydown:stopPropagation="true" /></label>
                        }
                    </div>
                }
            </section>
        }
        @if (CanMoves)
        {
            <ObsidianSection Title="@Text["Development.Moves.Label"]" Icon="ObsidianIconKind.Swords" Class="tools-panel">
                <div class="tools-moves">
                    @for (int index = 0; index < _moveIds.Length; index++)
                    {
                        int moveIndex = index;
                        <div><span class="tools-field-label">@Text["Redesign.Tools.MoveSlot", index + 1]</span><DevelopmentCatalogPicker Options="@_state.Moves" SelectedId="@_moveIds[index]" SelectedIdChanged="id => SetMoveSelectionAsync(moveIndex, id)" ClearSelectionOnInput="false" AllowClear="true" ClearLabel="@Text["Redesign.Tools.RemoveMove", index + 1]" Placeholder="@Text["Redesign.Tools.NoMove"]" AriaLabel="@Text["Development.Moves.Slot", index + 1]" EmptyText="@Text["Development.NoMatches"]" Disabled="@(_loading || _state.Player is null)" /></div>
                    }
                </div>
            </ObsidianSection>
        }
        @if (CanGiveItem)
        {
            <ObsidianSection Title="@Text["Development.Item.Title"]" Icon="ObsidianIconKind.PackagePlus" Class="tools-panel">
                <div class="tools-item-row">
                    <DevelopmentCatalogPicker Options="@_state.Items" SelectedId="@_itemId" SelectedIdChanged="SetItemSelection" Placeholder="@Text["Development.Item.Search"]" AriaLabel="@Text["Development.Item.Title"]" EmptyText="@Text["Development.NoMatches"]" Disabled="@_loading" />
                    <label class="tools-quantity"><span aria-hidden="true">×</span><input type="number" min="1" max="999" @bind="_quantity" aria-label="@Text["Development.Item.Quantity"]" disabled="@_loading" @onkeydown:stopPropagation="true" /></label>
                    <button type="button" class="obsidian-button obsidian-settings-primary" disabled="@(_loading || string.IsNullOrWhiteSpace(_itemId))" @onclick="GiveItemAsync">@Text["Development.Item.Action"]</button>
                </div>
            </ObsidianSection>
        }
        @if (CanEvolution && _evolutionsLoading)
        {
            <p class="development-evolution-loading" role="status"><span class="connection-work-spinner" aria-hidden="true"></span>@Text["Development.Evolution.Loading"]</p>
        }
        else if (CanEvolution && _state.Player is not null && (_state.Evolutions.Count > 0 || _state.Devolutions.Count > 0))
        {
            <ObsidianSection Title="@Text["Redesign.Tools.Evolution"]" Icon="ObsidianIconKind.Branch" Class="tools-panel">
                <div class="tools-evolution-options">
                    @if (_state.Evolutions.Count > 0)
                    {
                        <div><span class="tools-field-label">@Text["Development.Evolution.EvolveAction"]</span><DevelopmentCatalogPicker Options="@_state.Evolutions" SelectedId="@_evolutionId" SelectedIdChanged="EvolveSelectionAsync" Placeholder="@Text["Development.Evolution.SelectEvolution"]" AriaLabel="@Text["Development.Evolution.EvolveAction"]" EmptyText="@Text["Development.Evolution.None"]" Disabled="@_loading" /></div>
                    }
                    @if (_state.Devolutions.Count > 0)
                    {
                        <div><span class="tools-field-label">@Text["Development.Evolution.DevolveAction"]</span><DevelopmentCatalogPicker Options="@_state.Devolutions" SelectedId="@_devolutionId" SelectedIdChanged="DevolveSelectionAsync" Placeholder="@Text["Development.Evolution.SelectDevolution"]" AriaLabel="@Text["Development.Evolution.DevolveAction"]" EmptyText="@Text["Development.Evolution.None"]" Disabled="@_loading" /></div>
                    }
                </div>
            </ObsidianSection>
        }
    }
</section>
