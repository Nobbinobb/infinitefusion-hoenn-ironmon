<div class="lookup-relation">
    <PokemonSprite FitVisibleBounds="true" GameRoot="@GameRoot" SpritePath="@Relation.SpritePath" Label="@Relation.SpeciesName" Size="48" CssClass="lookup-relation-sprite" />
    <button class="lookup-relation-action" type="button" @onclick="SelectAsync">
        <span class="lookup-relation-copy">
            <strong>@Relation.SpeciesName</strong>
            <small>@Relation.Label</small>
        </span>
        <PokemonObtainabilityMark Status="@Relation.ObtainabilityStatus" />
    </button>
</div>
