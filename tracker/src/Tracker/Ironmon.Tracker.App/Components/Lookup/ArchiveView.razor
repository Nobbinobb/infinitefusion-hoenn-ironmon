<SectionContent SectionName="archive-navigation">
    <ArchiveRunPicker Recipes="_recipes" SelectedRecipe="GetSelectedRecipe()" HistorySelected="_showHistory" RunSelected="SelectRun" HistoryRequested="ShowHistory" />
</SectionContent>
<section class="obsidian-archive archive-navigation-view" role="tabpanel" aria-label="@Text["Archive.Title"]">
    @if (_showHistory)
    {
        <div class="obsidian-archive-content archive-history-content">
            <SaveSlotAttemptHistory Slots="@CompletedRuns.GetLatestSaveSlotStatistics(CurrentStatistics)" CurrentSaveSlot="@CurrentStatistics?.SaveSlot" Recipes="_recipes" RunSelected="OpenHistoryRun" />
        </div>
    }
    else if (GetSelectedRecipe() is CompletedRunRecipePayload selectedRecipe)
    {
        <nav class="obsidian-lookup-tabs obsidian-archive-tabs" role="tablist" aria-label="@Text["Archive.Sections.Label"]">
            @foreach (ArchiveSection section in Enum.GetValues<ArchiveSection>())
            {
                <button type="button" role="tab" aria-selected="@(_selectedSection == section ? "true" : "false")" @onclick="() => SelectSection(section)"><ObsidianIcon Kind="@GetSectionIcon(section)" />@GetSectionName(section)</button>
            }
        </nav>
        <div class="obsidian-archive-content archive-run-content" role="tabpanel" aria-label="@GetSectionName(ArchiveSection.Summary)" hidden="@(_selectedSection != ArchiveSection.Summary)">
            <div class="obsidian-archive-run-actions">
                <ArchiveRunEntry Recipe="selectedRecipe" />
                <SeedTokenExportPanel @key="selectedRecipe.RunId" Recipe="selectedRecipe" Title="@Text["Seeds.ArchiveExport.Title"]" Description="@Text["Seeds.ArchiveExport.Description"]" Compact="true" />
            </div>
            <RunStatistics @key="selectedRecipe.RunId" Statistics="selectedRecipe.Statistics" />
        </div>
        <div class="obsidian-archive-content archive-run-content" role="tabpanel" aria-label="@GetSectionName(ArchiveSection.Areas)" hidden="@(_selectedSection != ArchiveSection.Areas)">
            <AreaLookupExplorer @key="selectedRecipe.RunId" SourceKey="@($"archive:{selectedRecipe.RunId}")" RunId="@selectedRecipe.RunId" Recipe="selectedRecipe" GameRoot="@GameRoot" />
        </div>
        <div class="obsidian-archive-content archive-run-content" role="tabpanel" aria-label="@GetSectionName(ArchiveSection.Pokemon)" hidden="@(_selectedSection != ArchiveSection.Pokemon)">
            <PokemonLookupExplorer @key="selectedRecipe.RunId" Recipe="selectedRecipe" GameRoot="@GameRoot" />
        </div>
    }
    else
    {
        <div class="obsidian-archive-empty"><ObsidianIcon Kind="ObsidianIconKind.Archive" /><h3>@Text["Archive.NoCompletedRun"]</h3><p>@Text["Archive.NoCompletedRunDescription"]</p></div>
    }
</section>
