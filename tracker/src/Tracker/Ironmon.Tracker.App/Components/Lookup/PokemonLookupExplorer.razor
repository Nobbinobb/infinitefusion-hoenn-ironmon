<div class="lookup-explorer @(ReturnRequested.HasDelegate || _showDetail && _lookup is not null ? "research-explorer" : string.Empty)">
    @if (!ReturnRequested.HasDelegate && (!_showDetail || _lookup is null))
    {
        <div class="research-search">
            <label class="research-search-field"><ObsidianIcon Kind="ObsidianIconKind.Search" /><input type="search" placeholder="@Text["Lookup.Search.SearchPokemonName"]" aria-label="@Text["Lookup.Search.PokemonName"]" @bind="_query" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" @onkeydown:stopPropagation="true" />
            </label><button type="button" class="obsidian-button obsidian-settings-primary" disabled="@_loading" @onclick="SearchAsync">@Text["Lookup.Search.Search"]</button>
        </div>

        @if (_error is not null)
        {
            <p class="lookup-error" role="alert">@_error</p>
        }
        else if (_loading)
        {
            <p class="lookup-message">@LoadingMessage</p>
        }
        else if (_searched && _matches.Count == 0 && _lookup is null)
        {
            <p class="lookup-message">@Text["Lookup.Search.NoMatchingPokemon"]</p>
        }

        @if (_matches.Count > 0)
        {
            <p class="research-search-caption">@Text[DebugMode ? "Redesign.Tools.SearchMatchCount" : "Redesign.Archive.SearchMatchCount", _matchTotal]</p>
            <div class="research-search-legend">
                <span><PokemonObtainabilityMark Status="PokemonObtainabilityStatus.Obtainable" />@Text["Lookup.Obtainability.Obtainable"]</span>
                <span><PokemonObtainabilityMark Status="PokemonObtainabilityStatus.Unobtainable" />@Text["Lookup.Obtainability.Unobtainable"]</span>
                <span><PokemonObtainabilityMark Status="PokemonObtainabilityStatus.Calculating" />@Text["Lookup.Obtainability.Calculating"]</span>
            </div>
            <div class="research-search-list" aria-label="@Text["Lookup.Search.PokemonSearchResults"]">
                @foreach (PokemonSearchMatch match in _matches)
                {
                    <button type="button" class="research-search-match" disabled="@_loading" @onclick="() => NavigateToPokemonAsync(match)">
                        <span><strong>@match.SpeciesName</strong><small>@match.SpeciesId</small></span>
                        <PokemonObtainabilityMark Status="@match.ObtainabilityStatus" />
                    </button>
                }
            </div>

            <ObsidianPager State="_searchPagination" Total="_matchTotal" Label="@Text["Lookup.Search.PokemonSearchResultPages"]" Previous="PreviousSearchPageAsync" Next="NextSearchPageAsync" Disabled="_loading" />
        }
        @if (!_searched && !_loading && _error is null)
        {
            <div class="research-search-empty"><ObsidianIcon Kind="ObsidianIconKind.Search" /><h3>@Text["Redesign.Archive.SearchTitle"]</h3><p>@Text[DebugMode ? "Redesign.Tools.SearchDescription" : "Redesign.Archive.SearchDescription"]</p></div>
        }

    }
    @if (ReturnRequested.HasDelegate || _lookup is not null && _showDetail)
    {
        <div class="research-breadcrumb">
            <button type="button" disabled="@(_loading && !ReturnRequested.HasDelegate)" @onclick="ReturnAsync">← @(ReturnRequested.HasDelegate ? ReturnLabel : Text["Redesign.Research.Results"])</button>
            @if (Recipe is not null)
            {
                <span>@Text["Redesign.Research.Seed", Recipe.Seed]</span>
            }
        </div>
        @if (_error is not null)
        {
            <p class="lookup-error" role="alert">@_error</p>
        }
        @if (_loading)
        {
            <p class="research-loading" role="status">@LoadingMessage</p>
        }

    }
    @if (_lookup is not null && _showDetail)
    {
        <nav class="lookup-history" aria-label="@Text["Lookup.Search.PokemonLookupHistory"]">
            <button type="button" disabled="@(!_history.CanGoBack || _loading)" @onclick="GoBackAsync">&#8592; @Text["Lookup.Search.Back"]</button>
            <button type="button" disabled="@(!_history.CanGoForward || _loading)" @onclick="GoForwardAsync">@Text["Lookup.Search.Forward"] &#8594;</button>
        </nav>
        <PokemonLookupCard Pokemon="@_lookup" Recipe="@Recipe" DebugMode="@DebugMode" GameRoot="@GameRoot" PokemonSelected="NavigateToPokemonAsync" />
    }
</div>
