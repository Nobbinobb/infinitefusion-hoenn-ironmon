<section class="evolution-targets" aria-busy="@(_loading ? "true" : "false")" aria-label="@AriaLabel">
    <header class="evolution-candidate-heading">
        <p class="section-label">@Heading</p>
        <div class="evolution-candidate-heading-actions">
            @if (_hasLoadedPage)
            {
                <span>@Text["Lookup.Candidates.Total", _total]</span>
            }
            @if (ShowGraphAction)
            {
                <button type="button" class="evolution-candidate-graph-action" @onclick="GraphOpened">@Text["Lookup.Graph.OpenShort"]</button>
            }
        </div>
    </header>
    @if (ShowFilter)
    {
        <div class="lookup-search evolution-candidate-search">
            <input type="search" placeholder="@Text["Lookup.Candidates.Filter"]" aria-label="@Text["Lookup.Candidates.Filter"]" @bind="_query" @bind:event="oninput" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true" />
            <button type="button" disabled="@_loading" @onclick="ApplyFilterAsync">@Text["Lookup.Candidates.FilterButton"]</button>
        </div>
    }
    <div class="evolution-candidate-status" role="status">
        @if (_error is not null)
        {
            <p class="lookup-error" role="alert">@_error</p>
            <button type="button" disabled="@_loading" @onclick="RetryPageAsync">@Text["Lookup.Graph.Retry"]</button>
        }
        else if (_loading)
        {
            <p class="lookup-message">@Text["Lookup.Candidates.Loading"]</p>
        }
    </div>
    @if (_hasLoadedPage && _matches.Count == 0)
    {
        <p class="lookup-message">@Text["Lookup.Candidates.NoMatches"]</p>
    }
    @if (_matches.Count > 0)
    {
        <div class="evolution-target-grid">
            @foreach (EvolutionCandidateSnapshot candidate in _matches)
            {
                <EvolutionCandidateButton Disabled="_loading" Candidate="@candidate" GameRoot="@GameRoot" Selected="@Selected" />
            }
        </div>
        <ObsidianPagingControls Label="@Text["Lookup.Candidates.Pages"]" RangeText="@GetRangeText()" PreviousDisabled="@(_loading || !_pagination.HasPrevious)" NextDisabled="@(_loading || !_pagination.HasNext(_total, _matches.Count))" Previous="PreviousPageAsync" Next="NextPageAsync" />
    }
</section>
