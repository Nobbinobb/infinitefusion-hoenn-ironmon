<section class="lookup-learnset" aria-label="Complete level-up learnset">
    <header>
        <p class="section-label">LEVEL-UP LEARNSET</p>
        <span>@Pokemon.Learnset.Count moves</span>
    </header>
    <div class="move-list">
        @foreach (ObservedMoveSnapshot move in Pokemon.Learnset)
        {
            <button class="lookup-learnset-row @MovePresentation.GetTypeColorClass(move.Type)" type="button" @onclick="() => SelectMove(move)">
                <span>Lv. @move.LearnedLevel</span>
                <span class="lookup-move-name"><MoveCategoryIcon Category="@move.Category" /><strong>@move.Name</strong></span>
            </button>
        }
    </div>
</section>

@if (_selectedMove is not null)
{
    <MoveDetailPanel Name="@_selectedMove.Name"
                     Type="@_selectedMove.Type"
                     Category="@_selectedMove.Category"
                     Description="@_selectedMove.Description"
                     Power="@_selectedMove.Power"
                     Accuracy="@_selectedMove.Accuracy"
                     PpText="@($"{_selectedMove.TotalPp} PP")"
                     LearnedLevel="@_selectedMove.LearnedLevel"
                     Closed="CloseMove" />
}
