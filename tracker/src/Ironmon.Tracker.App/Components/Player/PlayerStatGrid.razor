<div class="stat-grid" aria-label="@Text["Player.Stats.CalculatedPokemonStats"]">
    @foreach ((string Name, string Value, StatAdjustment Adjustment) stat in GetStats())
    {
        <div class="stat-row">
            <span>@stat.Name</span>
            <strong>
                <span class="@GetStatValueClass(stat.Adjustment)">@stat.Value</span>
            </strong>
        </div>
    }
</div>
