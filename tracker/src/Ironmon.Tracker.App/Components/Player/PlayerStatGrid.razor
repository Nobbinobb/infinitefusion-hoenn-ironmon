<div class="stat-grid" aria-label="Calculated Pokemon stats">
    @foreach ((string Name, string Value, StatAdjustment Adjustment) stat in GetStats())
    {
        <div class="stat-row">
            <span>@stat.Name</span>
            <strong>
                @stat.Value
                @if (stat.Adjustment != StatAdjustment.Neutral)
                {
                    <span class="@GetNatureClass(stat.Adjustment)">@GetNatureIndicator(stat.Adjustment)</span>
                }
            </strong>
        </div>
    }
</div>
