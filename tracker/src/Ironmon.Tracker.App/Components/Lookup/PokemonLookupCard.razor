<article class="lookup-pokemon" aria-label="@Text["Lookup.Card.GeneratedPokemonInformation"]">
    <nav class="pokemon-information-tabs" aria-label="@Text["Debug.Inspector.PokemonInspectorPages"]">
        <button type="button" class="@GetPageClass(PokemonInformationPage.Overview)" @onclick="() => SelectPageAsync(PokemonInformationPage.Overview)">@Text["Debug.Inspector.Overview"]</button>
        <button type="button" class="@GetPageClass(PokemonInformationPage.Abilities)" @onclick="() => SelectPageAsync(PokemonInformationPage.Abilities)">@Text["Debug.Inspector.Abilities"]</button>
        <button type="button" class="@GetPageClass(PokemonInformationPage.Stats)" @onclick="() => SelectPageAsync(PokemonInformationPage.Stats)">@Text["Debug.Inspector.Stats"]</button>
        <button type="button" class="@GetPageClass(PokemonInformationPage.Moves)" @onclick="() => SelectPageAsync(PokemonInformationPage.Moves)">@Text["Debug.Inspector.Moves"]</button>
        <button type="button" class="@GetPageClass(PokemonInformationPage.Evolutions)" @onclick="() => SelectPageAsync(PokemonInformationPage.Evolutions)">@Text["Debug.Inspector.Evolutions"]</button>
    </nav>

    @if (_selectedPage == PokemonInformationPage.Overview)
    {
        @if (Inspector?.Section == PokemonLookupSection.Stats)
        {
            <DebugPokemonOverview Pokemon="@Inspector" Types="@Pokemon.Types" GameRoot="@GameRoot" />
        }
        else
        {
            <div class="card-heading action-heading">
                <div class="sprite-placeholder live" aria-hidden="true">
                    @if (_spriteSource is not null)
                    {
                        <img src="@_spriteSource" alt="" />
                    }
                    else
                    {
                        <span>?</span>
                    }
                </div>
                <div class="identity-placeholder">
                    <p class="card-kicker">@(DebugMode ? "ACTIVE DEBUG RUN" : "POST-RUN DATA")</p>
                    <h2 class="identity-name"><span>@Pokemon.SpeciesName</span></h2>
                    <p class="typing-line">
                        @foreach (string type in Pokemon.Types)
                        {
                            <span class="typing-type @MovePresentation.GetTypeColorClass(type)">@type</span>
                        }
                    </p>
                </div>
            </div>
        }

        <PokemonLookupSupplementalData Pokemon="@Pokemon"
                                       Recipe="@Recipe"
                                       DebugMode="@DebugMode"
                                       GameRoot="@GameRoot"
                                       PokemonSelected="PokemonSelected" />
    }
    else if (_loadingPage == _selectedPage)
    {
        <p class="lookup-message">@Text["Lookup.Card.LoadingSection"]</p>
    }
    else if (_sectionError is not null)
    {
        <p class="lookup-message error">@_sectionError</p>
    }
    else if (_selectedPage == PokemonInformationPage.Abilities)
    {
        <DebugAbilitySlots Slots="@GetAbilitySlots()" />

        <section class="lookup-abilities" aria-label="@Text["Lookup.Card.AbilitiesHeading"]">
            <p class="section-label">@Text["Lookup.Card.AbilitiesHeading"]</p>
            <div>
                @foreach (AbilitySnapshot ability in ActivePokemon.Abilities)
                {
                    <button type="button" @onclick="() => SelectAbility(ability)">@ability.Name</button>
                }
            </div>
        </section>

        <GeneratorDiagnostics Heading="@Text["Debug.Overview.AbilityGeneratorHeading"]"
                              Diagnostics="@ActivePokemon.AbilityGenerator" />
    }
    else if (_selectedPage == PokemonInformationPage.Stats)
    {
        @if (Inspector is not null)
        {
            <DebugBaseStats Pokemon="@Inspector" />
        }
        else
        {
            <BaseStatVisualization Original="@ActivePokemon.OriginalBaseStats"
                                   Generated="@ActivePokemon.BaseStats"
                                   OriginalTotal="@ActivePokemon.OriginalBaseStatTotal"
                                   GeneratedTotal="@ActivePokemon.BaseStatTotal"
                                   Randomized="@ActivePokemon.BaseStatsRandomized"
                                   Fusion="@IsFusion()" />
        }

        <GeneratorDiagnostics Heading="@Text["Debug.BaseStats.GeneratorHeading"]"
                              Diagnostics="@ActivePokemon.BaseStatGenerator" />
    }
    else if (_selectedPage == PokemonInformationPage.Moves)
    {
        <MoveAccessTabs Access="@ActivePokemon.MoveAccess" />
        <GeneratorDiagnostics Heading="@Text["Lookup.Generator.MoveHeading"]"
                              Diagnostics="@ActivePokemon.MoveGenerator" />
    }
    else
    {
        @if (HasGeneratedEvolutionTargets())
        {
            <EvolutionCandidateLists SpeciesId="@ActivePokemon.SpeciesId"
                                     HasNormal="@(ActivePokemon.EvolutionTargets.Count > 0)"
                                     HasHead="@(ActivePokemon.HeadEvolutionTargets.Count > 0)"
                                     HasBody="@(ActivePokemon.BodyEvolutionTargets.Count > 0)"
                                     Recipe="@Recipe"
                                     DebugMode="@DebugMode"
                                     GameRoot="@GameRoot"
                                     Selected="PokemonSelected" />
        }

        @if (HasGeneratedEvolutionGraph())
        {
            <EvolutionGraph Current="@GetCurrentEvolutionNode()"
                            Predecessors="@ActivePokemon.EvolutionPredecessors"
                            Targets="@ActivePokemon.EvolutionTargets"
                            HeadTargets="@ActivePokemon.HeadEvolutionTargets"
                            BodyTargets="@ActivePokemon.BodyEvolutionTargets"
                            GameRoot="@GameRoot"
                            Selected="@PokemonSelected" />
        }

        @if (ActivePokemon.Evolutions.Count > 0)
        {
            <section class="lookup-relations" aria-label="@Text["Lookup.Card.EvolutionDestinations"]">
                <header><p class="section-label">@Text["Lookup.Card.CurrentEvolutionsHeading"]</p></header>
                <div class="lookup-relation-grid">
                    @foreach (PokemonRelationSnapshot evolution in ActivePokemon.Evolutions)
                    {
                        <PokemonRelationButton Relation="@evolution" GameRoot="@GameRoot" Selected="PokemonSelected" />
                    }
                </div>
            </section>
        }

        @if (ActivePokemon.PreviousEvolutions.Count > 0)
        {
            <section class="lookup-relations" aria-label="@Text["Lookup.Card.PreviousEvolutions"]">
                <header><p class="section-label">@Text["Lookup.Card.PreviousEvolutionHeading"]</p></header>
                <div class="lookup-relation-grid">
                    @foreach (PokemonRelationSnapshot previousEvolution in ActivePokemon.PreviousEvolutions)
                    {
                        <PokemonRelationButton Relation="@previousEvolution" GameRoot="@GameRoot" Selected="PokemonSelected" />
                    }
                </div>
            </section>
        }

        @if (!HasGeneratedEvolutionGraph() && ActivePokemon.Evolutions.Count == 0 && ActivePokemon.PreviousEvolutions.Count == 0)
        {
            <p class="lookup-message">@Text["Debug.Inspector.NoGeneratedEvolutionTargets"]</p>
        }

        <GeneratorDiagnostics Heading="@Text["Lookup.Generator.EvolutionHeading"]"
                              Diagnostics="@ActivePokemon.EvolutionGenerator" />
    }
</article>

@if (_selectedAbility is not null)
{
    <AbilityDetailPanel Ability="@_selectedAbility" Closed="CloseAbility" />
}
