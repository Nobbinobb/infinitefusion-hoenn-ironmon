@if (Status is not null)
{
    @if (ShowLabel)
    {
        <span class="@CssClass" title="@Label">
            @if (IncludeIcon)
            {
                <span aria-hidden="true">@Icon</span>
            }
            @Label
        </span>
    }
    else
    {
        <span class="@CssClass" title="@Label" aria-label="@Label">@Icon</span>
    }
}
