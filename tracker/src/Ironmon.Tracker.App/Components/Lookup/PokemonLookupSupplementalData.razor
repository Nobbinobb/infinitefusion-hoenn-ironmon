@if ((!DebugMode || Connection.HasDiagnosticCapability(DiagnosticCapabilities.WorldWildEncounters)) && (_wildOccurrences.Total > 0 || _loadingWildOccurrences || _wildOccurrenceError is not null))
{
    <section class="lookup-occurrences" aria-label="@Text["Lookup.Card.WildEncounterLocations"]">
        <header><p class="section-label">@Text[Redesigned ? "Redesign.Research.WildLocations" : "Lookup.Card.WildLocationsHeading"]</p><span>@Text["Lookup.Card.SlotCount", _wildOccurrences.Total]</span></header>
        @if (_loadingWildOccurrences)
        {
            <p class="lookup-message">@Text["Lookup.Areas.LoadingDetails"]</p>
        }
        <div class="lookup-occurrence-list">
            @foreach (WildPokemonOccurrenceSnapshot occurrence in _wildOccurrences.Matches)
            {
                <div class="lookup-occurrence">
                    <div>
                        <strong>@occurrence.RouteName</strong>
                        <small>@occurrence.Mode · @FormatWildTables(occurrence) · @FormatWildSlots(occurrence) · @FormatLevelRange(occurrence.MinimumLevel, occurrence.MaximumLevel)</small>
                        @if (occurrence.FusionChancePercent is not null)
                        {
                            <small>@FormatWildFusionOrigin(occurrence)</small>
                        }
                    </div>
                    <button type="button" @onclick="() => PokemonSelected.InvokeAsync(occurrence.SourceSpeciesId)">
                        Source: @occurrence.SourceSpeciesName
                    </button>
                    @if (occurrence.SecondarySourceSpeciesId is not null)
                    {
                        <button type="button" @onclick="() => PokemonSelected.InvokeAsync(occurrence.SecondarySourceSpeciesId)">
                            + @occurrence.SecondarySourceSpeciesName
                        </button>
                    }
                    @if (occurrence.ChancePercent is not null)
                    {
                        <span>@FormatChance(occurrence.ChancePercent.Value, occurrence.ChanceIsConditional)</span>
                    }
                </div>
            }
        </div>
        @if (_wildOccurrenceError is not null)
        {
            <p class="lookup-error" role="alert">@_wildOccurrenceError</p>
        }
        @if (_wildOccurrences.Total > TrackerProtocol.OccurrencePageSize)
        {
            <nav class="lookup-pager" aria-label="@Text["Lookup.Card.WildEncounterLocations"]">
                <button type="button" disabled="@(_loadingWildOccurrences || !_wildOccurrencePagination.HasPrevious)" @onclick="PreviousWildOccurrencePageAsync">@Text["Lookup.Fusion.Previous"]</button>
                <span>@GetOccurrenceRangeText(_wildOccurrencePagination, _wildOccurrences.Matches.Count, _wildOccurrences.Total)</span>
                <button type="button" disabled="@(_loadingWildOccurrences || !_wildOccurrencePagination.HasNext(_wildOccurrences.Total, _wildOccurrences.Matches.Count))" @onclick="NextWildOccurrencePageAsync">@Text["Lookup.Fusion.Next"]</button>
            </nav>
        }
    </section>
}

@if ((!DebugMode || Connection.HasDiagnosticCapability(DiagnosticCapabilities.WorldTrainerParties)) && _trainerOccurrences.Total > 0)
{
    <section class="lookup-occurrences" aria-label="@Text["Lookup.Card.TrainerPartyLocations"]">
        <header><p class="section-label">@Text[Redesigned ? "Redesign.Research.Trainers" : "Lookup.Card.TrainersHeading"]</p><span>@Text["Lookup.Card.SlotCount", _trainerOccurrences.Total]</span></header>
        <div class="lookup-occurrence-list">
            @foreach (TrainerPokemonOccurrenceSnapshot occurrence in _trainerOccurrences.Matches)
            {
                <div class="lookup-occurrence">
                    <div>
                        <strong>@occurrence.TrainerType @occurrence.TrainerName</strong>
                        <small>@Text["Lookup.Card.TrainerOccurrenceSummary", occurrence.Slot, occurrence.Level, occurrence.RouteName ?? Text["Lookup.Card.LocationUnavailable"]]</small>
                    </div>
                    <button type="button" @onclick="() => PokemonSelected.InvokeAsync(occurrence.SourceSpeciesId)">
                        Source: @occurrence.SourceSpeciesName
                    </button>
                </div>
            }
        </div>
        @if (_trainerOccurrenceError is not null)
        {
            <p class="lookup-error" role="alert">@_trainerOccurrenceError</p>
        }
        @if (_trainerOccurrences.Total > TrackerProtocol.OccurrencePageSize)
        {
            <nav class="lookup-pager" aria-label="@Text["Lookup.Card.TrainerPartyLocations"]">
                <button type="button" disabled="@(_loadingTrainerOccurrences || !_trainerOccurrencePagination.HasPrevious)" @onclick="PreviousTrainerOccurrencePageAsync">@Text["Lookup.Fusion.Previous"]</button>
                <span>@GetOccurrenceRangeText(_trainerOccurrencePagination, _trainerOccurrences.Matches.Count, _trainerOccurrences.Total)</span>
                <button type="button" disabled="@(_loadingTrainerOccurrences || !_trainerOccurrencePagination.HasNext(_trainerOccurrences.Total, _trainerOccurrences.Matches.Count))" @onclick="NextTrainerOccurrencePageAsync">@Text["Lookup.Fusion.Next"]</button>
            </nav>
        }
    </section>
}

@if ((!DebugMode || Connection.HasDiagnosticCapability(DiagnosticCapabilities.PokemonOverview)) && Overview.FusionBases.Count > 0)
{
    <section class="lookup-relations" aria-label="@Text["Lookup.Card.DisplayedFusionComponents"]">
        <header><p class="section-label">@Text[Redesigned ? "Redesign.Research.DisplayedComponents" : "Lookup.Card.DisplayedComponentsHeading"]</p></header>
        <div class="lookup-relation-grid">
            @foreach (PokemonRelationSnapshot fusionBase in Overview.FusionBases)
            {
                <PokemonRelationButton Relation="@fusionBase" GameRoot="@GameRoot" Selected="PokemonSelected" />
            }
        </div>
    </section>
}

@if ((!DebugMode || Connection.HasDiagnosticCapability(DiagnosticCapabilities.PokemonOverview)) && Overview.ReverseFusion is not null)
{
    <section class="lookup-relations" aria-label="@Text["Lookup.Card.IronmonReverseFusion"]">
        <header><p class="section-label">@Text[Redesigned ? "Redesign.Research.IronmonReverse" : "Lookup.Card.IronmonReverseHeading"]</p></header>
        <div class="lookup-relation-grid">
            <PokemonRelationButton Relation="@Overview.ReverseFusion" GameRoot="@GameRoot" Selected="PokemonSelected" />
        </div>
    </section>
}

@if ((!DebugMode || Connection.HasDiagnosticCapability(DiagnosticCapabilities.FusionMaterialPairs)) && Pokemon.Identity.Fusion)
{
    <section class="lookup-relations" aria-label="@Text["Lookup.Card.IronmonFusionMaterials"]">
        <header><p class="section-label">@Text[Redesigned ? "Redesign.Research.FusionMaterials" : "Lookup.Card.FusionMaterialsHeading"]</p></header>
        @if (_loadingFusionMaterials)
        {
            <p class="lookup-empty">@Text["Lookup.Card.LoadingFusionMaterials"]</p>
        }
        else if (_fusionMaterialError is not null)
        {
            <p class="lookup-error" role="alert">@_fusionMaterialError</p>
            <button type="button" @onclick="RetryFusionMaterialPageAsync">@Text["Lookup.Graph.Retry"]</button>
        }
        else if (_fusionMaterials.Total == 0)
        {
            <p class="lookup-empty">@Text["Lookup.Card.NoFusionMaterials"]</p>
        }
        else
        {
            <div class="lookup-material-list">
                @foreach (FusionMaterialPairSnapshot materials in _fusionMaterials.Matches)
                {
                    <div class="lookup-material-pair">
                        <PokemonRelationButton Relation="@materials.Body" GameRoot="@GameRoot" Selected="PokemonSelected" />
                        <span aria-hidden="true">+</span>
                        <PokemonRelationButton Relation="@materials.Head" GameRoot="@GameRoot" Selected="PokemonSelected" />
                    </div>
                }
            </div>
            @if (_fusionMaterials.Total > TrackerProtocol.FusionMaterialPageSize)
            {
                <nav class="lookup-pager" aria-label="@Text["Lookup.Fusion.FusionMaterialSearchPages"]">
                    <button type="button" disabled="@(!_fusionMaterialPagination.HasPrevious)" @onclick="PreviousFusionMaterialPageAsync">@Text["Lookup.Fusion.Previous"]</button>
                    <span>@GetFusionMaterialRangeText()</span>
                    <button type="button" disabled="@(!_fusionMaterialPagination.HasNext(_fusionMaterials.Total, _fusionMaterials.Matches.Count))" @onclick="NextFusionMaterialPageAsync">@Text["Lookup.Fusion.Next"]</button>
                </nav>
            }
        }
    </section>
}

@if ((!DebugMode || Connection.HasDiagnosticCapability(DiagnosticCapabilities.FusionPreviewResults)) && !Pokemon.Identity.Fusion)
{
    <IronmonFusionSearch Pokemon="@Pokemon"
                         Recipe="@Recipe"
                         DebugMode="@DebugMode"
                         GameRoot="@GameRoot"
                         PokemonSelected="PokemonSelected" />
}
