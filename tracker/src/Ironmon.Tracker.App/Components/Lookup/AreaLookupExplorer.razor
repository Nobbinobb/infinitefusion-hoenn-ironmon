<section class="area-lookup" aria-label="@Text["Lookup.Areas.Title"]">
    @if (ShowHeading)
    {
        <header class="area-lookup-heading">
            <div>
                <p class="card-kicker">@Text["Lookup.Areas.Kicker"]</p>
                <h3>@Text["Lookup.Areas.Title"]</h3>
            </div>
        </header>
    }

    @if (ShowCategoryTabs)
    {
        <nav class="area-category-tabs" role="tablist" aria-label="@Text["Lookup.Areas.Categories"]">
            @foreach (AreaContentCategory category in Categories)
            {
                <button type="button"
                        class="@GetCategoryTabClass(category)"
                        role="tab"
                        aria-selected="@(_selectedCategory == category)"
                        @onclick="() => SelectCategory(category)">
                    @GetCategoryName(category)
                </button>
            }
        </nav>
    }

    @if (_error is not null)
    {
        <p class="lookup-error" role="alert">@_error</p>
    }
    else if (_loadingSummaries)
    {
        <p class="lookup-message">@Text["Lookup.Areas.Loading"]</p>
    }
    else if (_areas.Count == 0)
    {
        <p class="lookup-message">@Text["Lookup.Areas.Empty"]</p>
    }
    else
    {
        IReadOnlyList<AreaSummaryPayload> visibleAreas = GetVisibleAreas();
        <div class="area-groups" role="tabpanel">
            @foreach (AreaSummaryPayload area in GetPagedAreas(visibleAreas))
            {
                bool expanded = IsExpanded(area.AreaId);
                <article class="area-group">
                    <button type="button"
                            class="area-group-summary"
                            aria-expanded="@expanded"
                            @onclick="() => ToggleAreaAsync(area.AreaId)">
                        <span class="area-group-chevron" aria-hidden="true">@(expanded ? "−" : "+")</span>
                        <strong>@area.Name</strong>
                        <span>@GetProgressText(area)</span>
                    </button>

                    @if (expanded)
                    {
                        <div class="area-group-details">
                            @if (_loadingDetails.Contains(GetDetailKey(area.AreaId)))
                            {
                                <p class="lookup-message">@Text["Lookup.Areas.LoadingDetails"]</p>
                            }
                            else if (_detailErrors.TryGetValue(GetDetailKey(area.AreaId), out string? detailError))
                            {
                                <p class="lookup-error" role="alert">@detailError</p>
                            }
                            else if (_details.TryGetValue(GetDetailKey(area.AreaId), out AreaLookupDetailResponsePayload? detail))
                            {
                                @switch (_selectedCategory)
                                {
                                    case AreaContentCategory.Trainer:
                                        <div class="area-entry-list">
                                            @foreach (AreaTrainerEntryPayload trainer in GetPagedEntries(area.AreaId, detail.Trainers))
                                            {
                                                <article class="area-entry @(trainer.Defeated ? "completed" : null)">
                                                    <header>
                                                        <strong>@trainer.TrainerType @trainer.TrainerName</strong>
                                                        <span>@(trainer.Defeated ? Text["Lookup.Areas.Defeated"] : Text["Lookup.Areas.NotDefeated"])</span>
                                                    </header>
                                                    @if (trainer.DetailsRevealed && trainer.Party.Count > 0)
                                                    {
                                                        <div class="area-trainer-party">
                                                            @foreach (AreaTrainerPokemonPayload pokemon in trainer.Party)
                                                            {
                                                                <div class="area-trainer-pokemon">
                                                                    <PokemonSprite GameRoot="@GameRoot" SpritePath="@pokemon.SpritePath" Label="@pokemon.SpeciesName" Size="45" CssClass="area-trainer-sprite" />
                                                                    <div>
                                                                        <strong>@pokemon.SpeciesName</strong>
                                                                        <small>@Text["Lookup.Areas.Level", pokemon.Level]</small>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <p>@Text["Lookup.Areas.PokemonCount", trainer.PartySize]</p>
                                                        <div class="area-trainer-party unknown">
                                                            @foreach (int slot in Enumerable.Range(1, trainer.PartySize))
                                                            {
                                                                <div class="area-trainer-pokemon unknown">
                                                                    <div class="area-trainer-mystery" aria-hidden="true"><span>?</span></div>
                                                                    <div>
                                                                        <strong>@Text["Lookup.Areas.UnknownPokemon"]</strong>
                                                                        <small>@Text["Lookup.Areas.Slot", slot]</small>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </article>
                                            }
                                        </div>
                                        break;
                                    case AreaContentCategory.Encounter:
                                        <div class="area-environment-list">
                                            @foreach (AreaEncounterEnvironmentPayload environment in detail.EncounterEnvironments)
                                            {
                                                bool environmentExpanded = IsEnvironmentExpanded(area.AreaId, environment.Key);
                                                string environmentDetailKey = GetDetailKey(area.AreaId, environment.Key);
                                                <section class="area-environment-group">
                                                    <button type="button"
                                                            class="area-environment-summary"
                                                            aria-expanded="@environmentExpanded"
                                                            @onclick="() => ToggleEnvironmentAsync(area.AreaId, environment.Key)">
                                                        <span class="area-group-chevron" aria-hidden="true">@(environmentExpanded ? "−" : "+")</span>
                                                        <strong>@GetEnvironmentName(environment.Key)</strong>
                                                    </button>
                                                    @if (environmentExpanded)
                                                    {
                                                        <div class="area-environment-details">
                                                            @if (_loadingDetails.Contains(environmentDetailKey))
                                                            {
                                                                <p class="lookup-message">@Text["Lookup.Areas.LoadingDetails"]</p>
                                                            }
                                                            else if (_detailErrors.TryGetValue(environmentDetailKey, out string? environmentError))
                                                            {
                                                                <p class="lookup-error" role="alert">@environmentError</p>
                                                            }
                                                            else if (_details.TryGetValue(environmentDetailKey, out AreaLookupDetailResponsePayload? environmentDetail))
                                                            {
                                                                @foreach (EncounterSubsection subsection in GetEncounterSubsections(environmentDetail))
                                                                {
                                                                    <section class="area-encounter-subsection">
                                                                        <h4>@subsection.Name</h4>
                                                                        <div class="area-entry-list">
                                                                            @foreach (AreaEncounterEntryPayload encounter in subsection.Encounters)
                                                                            {
                                                                                <article class="area-entry area-encounter-entry @(encounter.Encountered ? "completed" : null)">
                                                                                    <header>
                                                                                        <strong>@Text["Lookup.Areas.Slot", encounter.Slot]</strong>
                                                                                        <span>@(encounter.Encountered ? Text["Lookup.Areas.Encountered"] : Text["Lookup.Areas.NotEncountered"])</span>
                                                                                    </header>
                                                                                    <div class="area-encounter-copy">
                                                                                        <p>@FormatEncounterRange(encounter) · @Text["Lookup.Areas.Probability", encounter.ProbabilityPercent]</p>
                                                                                        @if (encounter.DetailsRevealed)
                                                                                        {
                                                                                            <p class="area-entry-identity">@GetEncounterIdentity(encounter)@(encounter.IndependentFusion ? $" · {Text["Lookup.Areas.IndependentFusion"]}" : null)</p>
                                                                                        }
                                                                                    </div>
                                                                                    @if (encounter.DetailsRevealed)
                                                                                    {
                                                                                        <PokemonSprite GameRoot="@GameRoot" SpritePath="@encounter.SpritePath" Label="@GetEncounterIdentity(encounter)" Size="45" CssClass="area-encounter-sprite" />
                                                                                    }
                                                                                </article>
                                                                            }
                                                                            @foreach (AreaEncounterFusionEntryPayload fusion in subsection.Fusions)
                                                                            {
                                                                                <article class="area-entry area-encounter-entry @(fusion.Encountered ? "completed" : null)">
                                                                                    <header>
                                                                                        <strong>@(fusion.DetailsRevealed ? fusion.SpeciesName : Text["Lookup.Areas.UnknownPokemon"])</strong>
                                                                                        <span>@(fusion.Encountered ? Text["Lookup.Areas.EncounteredDerivedFusion"] : Text["Lookup.Areas.DerivedFusion"])</span>
                                                                                    </header>
                                                                                    <div class="area-encounter-copy">
                                                                                        <p>@FormatFusionSources(fusion)</p>
                                                                                        <p>@FormatFusionRange(fusion) · @FormatFusionOrigin(fusion)</p>
                                                                                    </div>
                                                                                    @if (fusion.DetailsRevealed)
                                                                                    {
                                                                                        <PokemonSprite GameRoot="@GameRoot" SpritePath="@fusion.SpritePath" Label="@fusion.SpeciesName" Size="45" CssClass="area-encounter-sprite" />
                                                                                    }
                                                                                </article>
                                                                            }
                                                                        </div>
                                                                    </section>
                                                                }
                                                                @if (environmentDetail.TotalCount > _pageSize)
                                                                {
                                                                    PaginationState environmentPagination = GetDetailPagination(area.AreaId, environment.Key);
                                                                    <nav class="lookup-pager area-entry-pager" aria-label="@Text["Lookup.Areas.EntryPages", GetEnvironmentName(environment.Key)]">
                                                                        <button type="button" disabled="@(!environmentPagination.HasPrevious)" @onclick="() => PreviousDetailPage(area.AreaId, environment.Key)">@Text["Lookup.Search.Previous"]</button>
                                                                        <span>@GetPageRangeText(environmentPagination, environmentDetail.TotalCount)</span>
                                                                        <button type="button" disabled="@(!environmentPagination.HasNext(environmentDetail.TotalCount))" @onclick="() => NextDetailPage(area.AreaId, environmentDetail.TotalCount, environment.Key)">@Text["Lookup.Search.Next"]</button>
                                                                    </nav>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </section>
                                            }
                                        </div>
                                        break;
                                    case AreaContentCategory.Item:
                                        <div class="area-entry-list">
                                            @foreach (AreaItemEntryPayload item in GetPagedEntries(area.AreaId, detail.Items))
                                            {
                                                <article class="area-entry @(item.Collected ? "completed" : null)">
                                                    <header>
                                                        <strong>@Text["Lookup.Areas.Coordinates", item.X, item.Y]</strong>
                                                        <span>@(item.Collected ? Text["Lookup.Areas.Collected"] : Text["Lookup.Areas.NotCollected"])</span>
                                                    </header>
                                                    <p>@(item.Hidden ? Text["Lookup.Areas.HiddenItem"] : Text["Lookup.Areas.GroundItem"])</p>
                                                    @if (item.DetailsRevealed && item.Items.Count > 0)
                                                    {
                                                        <p class="area-entry-identity">@string.Join(", ", item.Items.Select(identity => identity.ItemName))</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="area-entry-identity unknown">@Text["Lookup.Areas.UnknownItem"]</p>
                                                    }
                                                </article>
                                            }
                                        </div>
                                        break;
                                }
                                int detailEntryCount = GetDetailEntryCount(detail);
                                @if (_selectedCategory != AreaContentCategory.Encounter && detailEntryCount > _pageSize)
                                {
                                    PaginationState detailPagination = GetDetailPagination(area.AreaId);
                                    <nav class="lookup-pager area-entry-pager" aria-label="@Text["Lookup.Areas.EntryPages", area.Name]">
                                        <button type="button" disabled="@(!detailPagination.HasPrevious)" @onclick="() => PreviousDetailPage(area.AreaId)">@Text["Lookup.Search.Previous"]</button>
                                        <span>@GetPageRangeText(detailPagination, detailEntryCount)</span>
                                        <button type="button" disabled="@(!detailPagination.HasNext(detailEntryCount))" @onclick="() => NextDetailPage(area.AreaId, detailEntryCount)">@Text["Lookup.Search.Next"]</button>
                                    </nav>
                                }
                            }
                        </div>
                    }
                </article>
            }
        </div>
        @if (visibleAreas.Count > _pageSize)
        {
            <nav class="lookup-pager area-summary-pager" aria-label="@Text["Lookup.Areas.AreaPages"]">
                <button type="button" disabled="@(!_areaPagination.HasPrevious)" @onclick="PreviousAreaPage">@Text["Lookup.Search.Previous"]</button>
                <span>@GetPageRangeText(_areaPagination, visibleAreas.Count)</span>
                <button type="button" disabled="@(!_areaPagination.HasNext(visibleAreas.Count))" @onclick="() => NextAreaPage(visibleAreas.Count)">@Text["Lookup.Search.Next"]</button>
            </nav>
        }
    }

</section>
