<section class="obsidian-archive-surface obsidian-archive-stats" aria-label="@Text["Lookup.Statistics.Heading"]">
    <div class="obsidian-archive-section-heading"><h3>@Text["Lookup.Statistics.Heading"]</h3><small>@(Statistics is null ? Text["Lookup.Statistics.UnavailableShort"] : Text["Lookup.Statistics.Attempt", Statistics.AttemptNumber])</small></div>
    @if (Statistics is null)
    {
        <div class="obsidian-archive-empty"><h3>@Text["Lookup.Statistics.Unavailable"]</h3><p>@Text["Lookup.Statistics.UnavailableDescription"]</p></div>
    }
    else
    {
        <nav class="obsidian-archive-stat-tabs" role="tablist" aria-label="@Text["Lookup.Statistics.Sections"]">
            @foreach (RunStatisticsSection section in Enum.GetValues<RunStatisticsSection>())
            {
                <button type="button" role="tab" aria-selected="@(_selectedSection == section ? "true" : "false")" @onclick="() => SelectSection(section)">@GetSectionName(section)</button>
            }
        </nav>
        <div role="tabpanel" hidden="@(_selectedSection != RunStatisticsSection.Overview)">
            <div class="obsidian-archive-overview">
                <ObsidianMetric Icon="ObsidianIconKind.Clock" Value="@FormatDuration(Statistics.ActiveSeconds)" Label="@Text["Lookup.Statistics.ActiveTime"]" />
                <ObsidianMetric Icon="ObsidianIconKind.Swords" Value="@Statistics.BattlesCompleted.ToString()" Label="@Text["Lookup.Statistics.Battles"]" />
                <ObsidianMetric Icon="ObsidianIconKind.TrendingUp" Value="@Statistics.HighestPlayerLevel.ToString()" Label="@Text["Lookup.Statistics.HighestLevel"]" />
                <ObsidianMetric Icon="ObsidianIconKind.Award" Value="@Statistics.BadgesEarned.ToString()" Label="@Text["Lookup.Statistics.Badges"]" />
            </div>
        </div>
        <div role="tabpanel" hidden="@(_selectedSection != RunStatisticsSection.Trainers)">
            <dl class="obsidian-archive-pairs">
                <div class="obsidian-archive-pair"><dt>@Text["Lookup.Statistics.DistinctSpecies"]</dt><dd>@Statistics.TrainerSpeciesDistinct</dd></div>
                <div class="obsidian-archive-pair"><dt>@Text["Lookup.Statistics.Defeated"]</dt><dd>@Statistics.TrainerDefeatedCount</dd></div>
                <div class="obsidian-archive-pair"><dt>@Text["Lookup.Statistics.AverageBst"]</dt><dd>@FormatAverage(Statistics.TrainerDefeatedBstAverage)</dd></div>
                <div class="obsidian-archive-pair"><dt>@Text["Lookup.Statistics.LowestBst"]</dt><dd>@FormatAverage(Statistics.TrainerDefeatedBstMinimum)</dd></div>
                <div class="obsidian-archive-pair"><dt>@Text["Lookup.Statistics.HighestBst"]</dt><dd>@FormatAverage(Statistics.TrainerDefeatedBstMaximum)</dd></div>
            </dl>
        </div>
        <div role="tabpanel" hidden="@(_selectedSection != RunStatisticsSection.Items)">
            <div class="obsidian-archive-items-totals">
                <div><strong>@Statistics.ItemsUsed</strong><small>@Text["Lookup.Statistics.ItemsUsed"]</small></div>
                <div><strong>@Statistics.TotalItemHealing</strong><small>@Text["Lookup.Statistics.TotalHealing"]</small></div>
                <div><strong>@Statistics.WastedItemHealing</strong><small>@Text["Lookup.Statistics.WastedHealing"]</small></div>
            </div>
            <ul class="obsidian-archive-item-usage" aria-label="@Text["Redesign.Archive.ItemUsage"]">
                @foreach (ArchivedItemUsage item in ArchiveItemPresentation.GetUsage(Statistics))
                {
                    <li class="obsidian-archive-used-item"><span class="obsidian-archive-used-item-icon" title="@Text[ItemCategoryPresentation.GetLabelKey(item.Category)]"><ObsidianIcon Kind="@ItemCategoryPresentation.GetIcon(item.Category)" /></span><span class="obsidian-archive-used-item-name">@item.Name</span><strong class="obsidian-archive-used-item-count">@item.Count</strong></li>
                }
            </ul>
            @if (Statistics.ItemsBySource.Values.All(source => source.Count == 0))
            {
                <p class="obsidian-archive-note">@Text["Lookup.Statistics.None"]</p>
            }
        </div>
    }
</section>
