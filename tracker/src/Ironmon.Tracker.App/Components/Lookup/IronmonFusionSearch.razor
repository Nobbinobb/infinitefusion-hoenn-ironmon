<section class="lookup-relations fusion-search" aria-label="@Text["Lookup.Fusion.IronmonFusionSearch"]">
    <header>
        <div>
            <p class="section-label">@Text["Lookup.Fusion.IronmonFusionsHeading"]</p>
            <span>@Text["Lookup.Fusion.FusionSearchDescription"]</span>
        </div>
    </header>

    <div class="lookup-search">
        <input type="search" placeholder="@Text["Lookup.Fusion.SearchSecondMaterial"]" aria-label="@Text["Lookup.Fusion.SecondFusionMaterial"]" @bind="_query" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" @onkeydown:stopPropagation="true" />
        <button type="button" disabled="@_loading" @onclick="SearchAsync">@Text["Lookup.Fusion.Search"]</button>
    </div>

    @if (_error is not null)
    {
        <p class="lookup-error" role="alert">@_error</p>
    }
    else if (_loading)
    {
        <p class="lookup-message">@Text["Lookup.Fusion.CalculatingFusionData"]</p>
    }
    else if (_searched && _matches.Count == 0)
    {
        <p class="lookup-message">@Text["Lookup.Fusion.NoMatchingNormalPokemon"]</p>
    }

    @if (_matches.Count > 0)
    {
        <div class="lookup-results fusion-search-results" aria-label="@Text["Lookup.Fusion.NormalPokemonSearchResults"]">
            @foreach (PokemonSearchMatch match in _matches)
            {
                <button type="button" disabled="@_loading" @onclick="() => SelectMaterialAsync(match)">
                    <strong>@match.SpeciesName</strong>
                    <span>@match.SpeciesId</span>
                </button>
            }
        </div>

        @if (_matchTotal > TrackerProtocol.DefaultSearchPageSize)
        {
            <nav class="lookup-pager" aria-label="@Text["Lookup.Fusion.FusionMaterialSearchPages"]">
                <button type="button" disabled="@(_loading || !HasPreviousPage())" @onclick="PreviousPageAsync">@Text["Lookup.Fusion.Previous"]</button>
                <span>@GetRangeText()</span>
                <button type="button" disabled="@(_loading || !HasNextPage())" @onclick="NextPageAsync">@Text["Lookup.Fusion.Next"]</button>
            </nav>
        }
    }

    @if (_outcomes.Count > 0)
    {
        <div class="fusion-outcomes" aria-label="@Text["Lookup.Fusion.IronmonFusionResults"]">
            @foreach (FusionOutcomeSnapshot outcome in _outcomes)
            {
                <div class="fusion-outcome">
                    <PokemonRelationButton Relation="@outcome.Body" GameRoot="@GameRoot" Selected="PokemonSelected" />
                    <span class="fusion-operator">+</span>
                    <PokemonRelationButton Relation="@outcome.Head" GameRoot="@GameRoot" Selected="PokemonSelected" />
                    <span class="fusion-operator">→</span>
                    <PokemonRelationButton Relation="@outcome.Result" GameRoot="@GameRoot" Selected="PokemonSelected" />
                </div>
            }
        </div>
    }
</section>
