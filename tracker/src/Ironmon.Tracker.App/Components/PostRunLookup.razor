<section class="pokemon-card lookup-view" role="tabpanel" aria-label="Post-run Pokemon lookup">
    <header class="lookup-heading">
        <div>
            <p class="card-kicker">COMPLETED RUNS</p>
            <h2>Generated Pokémon lookup</h2>
        </div>
    </header>

    @if (_recipes.Count == 0)
    {
        <div class="lookup-empty">
            <strong>No completed run yet</strong>
            <p>A lost or completed Ironmon run will add its reconstruction recipe here.</p>
        </div>
    }
    else
    {
        <div class="lookup-controls">
            <label>
                Run
                <select value="@_selectedRunId" @onchange="SelectRun" @onkeydown:stopPropagation="true">
                    @foreach (CompletedRunRecipePayload recipe in _recipes)
                    {
                        <option value="@recipe.RunId">@FormatRun(recipe)</option>
                    }
                </select>
            </label>
        </div>

        <div class="lookup-search">
            <input type="search" placeholder="Search Pokémon name" aria-label="Pokemon name" @bind="_query" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" @onkeydown:stopPropagation="true" />
            <button type="button" disabled="@_loading" @onclick="SearchAsync">Search</button>
        </div>

        @if (_error is not null)
        {
            <p class="lookup-error" role="alert">@_error</p>
        }
        else if (_loading)
        {
            <p class="lookup-message">Reconstructing generated data…</p>
        }
        else if (_searched && _matches.Count == 0 && _lookup is null)
        {
            <p class="lookup-message">No matching Pokémon found.</p>
        }

        @if (_matches.Count > 0)
        {
            <div class="lookup-results" aria-label="Pokemon search results">
                @foreach (PokemonSearchMatch match in _matches)
                {
                    <button type="button" disabled="@_loading" @onclick="() => NavigateToPokemonAsync(match.SpeciesId)">
                        <strong>@match.SpeciesName</strong>
                        <span>@match.SpeciesId</span>
                    </button>
                }
            </div>

            @if (_matchTotal > SearchPageSize)
            {
                <nav class="lookup-pager" aria-label="Pokemon search result pages">
                    <button type="button" disabled="@(_loading || !HasPreviousSearchPage())" @onclick="PreviousSearchPageAsync">Previous</button>
                    <span>@GetSearchRangeText()</span>
                    <button type="button" disabled="@(_loading || !HasNextSearchPage())" @onclick="NextSearchPageAsync">Next</button>
                </nav>
            }
        }

        @if (_lookup is not null && GetSelectedRecipe() is CompletedRunRecipePayload selectedRecipe)
        {
            <nav class="lookup-history" aria-label="Pokemon lookup history">
                <button type="button" disabled="@(_backHistory.Count == 0 || _loading)" @onclick="GoBackAsync">&#8592; Back</button>
                <button type="button" disabled="@(_forwardHistory.Count == 0 || _loading)" @onclick="GoForwardAsync">Forward &#8594;</button>
            </nav>
            <PokemonLookupCard Pokemon="@_lookup"
                               Recipe="@selectedRecipe"
                               GameRoot="@GameRoot"
                               PokemonSelected="NavigateToPokemonAsync" />
        }
    }
</section>
