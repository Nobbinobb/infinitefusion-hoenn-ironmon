@using Ironmon.Tracker.Core

<div class="detail-overlay" role="presentation" @onclick="Close">
    <section class="detail-panel" role="dialog" aria-modal="true" aria-labelledby="move-detail-title" @onclick:stopPropagation>
        <header class="detail-panel-header">
            <div class="detail-title">
                <MoveCategoryIcon Category="@Category" />
                <div>
                    <p class="card-kicker">MOVE INFORMATION</p>
                    <h2 id="move-detail-title" class="@MovePresentation.GetTypeColorClass(Type)">@Name</h2>
                </div>
            </div>
            <button class="detail-close" type="button" aria-label="Close move information" @onclick="Close">×</button>
        </header>

        <div class="detail-tags">
            <span class="typing-type @MovePresentation.GetTypeColorClass(Type)">@Type</span>
            <span>@GetCategoryName()</span>
            @if (Effectiveness is not null && Effectiveness != MoveEffectiveness.Neutral)
            {
                <span class="@GetDetailEffectivenessClass(Effectiveness.Value)">
                    <strong aria-hidden="true">@MovePresentation.GetEffectivenessSymbol(Effectiveness.Value)</strong>
                    @MovePresentation.GetEffectivenessTitle(Effectiveness.Value)
                </span>
            }
        </div>

        <dl class="detail-values">
            <div><dt>PP</dt><dd>@PpText</dd></div>
            <div><dt>Power</dt><dd>@GetPowerText()</dd></div>
            <div><dt>Accuracy</dt><dd>@GetAccuracyText()</dd></div>
            @if (LearnedLevel is not null)
            {
                <div><dt>Learned</dt><dd>Lv. @LearnedLevel</dd></div>
            }
        </dl>

        <p class="detail-description">@GetDescription()</p>
    </section>
</div>
