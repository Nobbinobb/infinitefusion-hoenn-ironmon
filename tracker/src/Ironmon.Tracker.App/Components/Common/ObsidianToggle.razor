<label class="obsidian-toggle @Class">
    @if (LabelFirst) { <span><strong>@Label</strong>@if (Description is not null) { <small>@Description</small> }</span> }
    <input class="obsidian-setting-switch" type="checkbox" role="switch" aria-label="@Label" checked="@Value" disabled="@Disabled" @onchange="HandleChangeAsync" />
    @if (!LabelFirst) { <span>@Label</span> }
</label>
