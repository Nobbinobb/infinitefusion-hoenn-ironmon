@if (LabelFirst)
{
    <div class="obsidian-toggle @Class">
        <ObsidianSettingLabel Label="@Label" ControlId="@_controlId" Description="@Description" />
        <input id="@_controlId" class="obsidian-setting-switch" type="checkbox" role="switch" aria-label="@Label" checked="@Value" disabled="@Disabled" @onchange="HandleChangeAsync" />
    </div>
}
else
{
    <label class="obsidian-toggle @Class">
        <input class="obsidian-setting-switch" type="checkbox" role="switch" aria-label="@Label" checked="@Value" disabled="@Disabled" @onchange="HandleChangeAsync" />
        <span>@Label</span>
    </label>
}
