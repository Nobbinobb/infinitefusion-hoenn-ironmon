<span class="pokemon-sprite-host">
    @if (!Interactive)
    {
        <span class="pokemon-sprite @CssClass" style="@GetSizeStyle(Size)" aria-hidden="true">
            @if (_spriteSource is not null) { <img class="pokemon-sprite-image" src="@_spriteSource" alt="" /> }
            else { <span>?</span> }
        </span>
    }
    else
    {
    <button class="pokemon-sprite @CssClass"
            type="button"
            style="@GetSizeStyle(Size)"
            disabled="@(_spriteSource is null)"
            aria-label="@GetEnlargeLabel()"
            aria-haspopup="dialog"
            @onclick="OpenDialog"
            @onclick:stopPropagation="true">
        @if (_spriteSource is not null)
        {
            <img class="pokemon-sprite-image" src="@_spriteSource" alt="" />
        }
        else
        {
            <span aria-hidden="true">?</span>
        }
    </button>
    }

</span>
