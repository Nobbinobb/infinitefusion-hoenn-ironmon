<section class="pokemon-card defense-view" role="tabpanel" aria-label="@Text["Defense.Title"]" @onkeydown="HandleKeyDown">
    <div class="defense-heading">
        <h2>@Name <small>@Text["Defense.Title"]</small></h2>
        <button type="button" class="defense-back" @ref="_backButton" @onclick="Closed">@Text["Defense.Back"]</button>
    </div>
    @if (Defense is null)
    {
        <p class="defense-help">@Text["Defense.Unavailable"]</p>
    }
    else
    {
        @if (Defense.LimitedInformation)
        {
            <p class="defense-help">@Text["Defense.KnownOnly"]</p>
        }
        @foreach (var group in MatchupGroups)
        {
            @if (group.Types.Count > 0)
            {
                <section class="defense-matchup-group">
                    <h3>@Text[group.Heading]</h3>
                    <div class="defense-matchups">
                        @foreach (DefenseTypeSnapshot entry in group.Types)
                        {
                            <div class="defense-matchup">
                                <span class="typing-type @MovePresentation.GetTypeColorClass(entry.Type)">@entry.Name</span>
                                @if (SameCategories(entry))
                                {
                                    <strong>@FormatRange(PhysicalMin(entry), PhysicalMax(entry))</strong>
                                }
                                else
                                {
                                    <span class="defense-category-values">
                                        @if (ShowPhysicalCategory(entry))
                                        {
                                            <span><strong>@FormatRange(PhysicalMin(entry), PhysicalMax(entry))</strong> @Text["Defense.Physical"]</span>
                                        }
                                        @if (ShowSpecialCategory(entry))
                                        {
                                            <span><strong>@FormatRange(SpecialMin(entry), SpecialMax(entry))</strong> @Text["Defense.Special"]</span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        }
        <DefenseRuleList Heading="@Text["Defense.Protection"]" Effects="Defense.Protections" />
        <DefenseRuleList Heading="@Text["Defense.Recovery"]" Effects="Defense.Recovery" />
    }
</section>
