<section class="base-stat-visualization" aria-label="@Text["Common.BaseStats.BaseStats"]">
    @if (!Randomized)
    {
        <div class="base-stat-legacy-note"><strong>@Text["Common.BaseStats.OriginalStats"]</strong><span>@Text["Common.BaseStats.LegacyBaseStatsDescription"]</span></div>
    }
    <div class="base-stat-view-switch" role="group" aria-label="@Text["Common.BaseStats.BaseStatDisplayMode"]">
        <button type="button" class="@GetModeClass(BaseStatDisplayMode.Table)" @onclick="() => SelectMode(BaseStatDisplayMode.Table)">@Text["Common.BaseStats.Table"]</button>
        <button type="button" class="@GetModeClass(BaseStatDisplayMode.GeneratedBars)" @onclick="() => SelectMode(BaseStatDisplayMode.GeneratedBars)">@Text["Common.BaseStats.GeneratedBars"]</button>
        <button type="button" class="@GetModeClass(BaseStatDisplayMode.DeltaBars)" @onclick="() => SelectMode(BaseStatDisplayMode.DeltaBars)">@Text["Common.BaseStats.DeltaBars"]</button>
    </div>

    @if (_mode == BaseStatDisplayMode.Table)
    {
        <div class="base-stat-comparison base-stat-heading" aria-hidden="true">
            <span>@Text["Common.BaseStats.Stat"]</span><span>@Text["Common.BaseStats.Original"]</span><span>@Text["Common.BaseStats.Generated"]</span><span>@Text["Common.BaseStats.Delta"]</span>
        </div>
        <div class="base-stat-table">
            @foreach ((string Name, int Original, int Generated, string? Dominance) stat in GetBaseStats())
            {
                <div class="base-stat-comparison">
                    <span>@if (stat.Dominance is not null) { <small title="@stat.Dominance">@stat.Dominance[0]</small> }<strong>@stat.Name</strong></span>
                    <span>@stat.Original</span>
                    <span>@stat.Generated</span>
                    <span class="@GetDeltaClass(stat.Original, stat.Generated)">@FormatDelta(stat.Original, stat.Generated)</span>
                </div>
            }
        </div>
        <div class="base-stat-comparison base-stat-total">
            <span><strong>BST</strong></span>
            <span>@OriginalTotal</span>
            <span>@GeneratedTotal</span>
            <span class="@GetDeltaClass(OriginalTotal, GeneratedTotal)">@FormatDelta(OriginalTotal, GeneratedTotal)</span>
        </div>
    }
    else
    {
        <div class="base-stat-bars">
            @foreach ((string Name, int Original, int Generated, string? Dominance) stat in GetBaseStats())
            {
                <div class="base-stat-bar-row">
                    <span><strong>@stat.Name</strong>@if (stat.Dominance is not null) { <small>@stat.Dominance</small> }</span>
                    <div class="base-stat-track">
                        @if (_mode == BaseStatDisplayMode.DeltaBars && stat.Original != stat.Generated)
                        {
                            <span class="base-stat-fill delta-base" style="width: @GetSharedBarWidth(stat.Original, stat.Generated)%"></span>
                            <span class="base-stat-delta @GetDeltaClass(stat.Original, stat.Generated)" style="left: @GetSharedBarWidth(stat.Original, stat.Generated)%; width: @GetDeltaBarWidth(stat.Original, stat.Generated)%"></span>
                        }
                        else
                        {
                            <span class="base-stat-fill generated" style="width: @GetBarWidth(stat.Generated)%"></span>
                        }
                    </div>
                    <span class="base-stat-bar-value">@stat.Generated@if (_mode == BaseStatDisplayMode.DeltaBars) { <small class="@GetDeltaClass(stat.Original, stat.Generated)">@FormatDelta(stat.Original, stat.Generated)</small> }</span>
                </div>
            }
        </div>
        @if (_mode == BaseStatDisplayMode.DeltaBars)
        {
            <div class="base-stat-legend"><span class="generated">@Text["Common.BaseStats.Generated"]</span><span class="positive">@Text["Common.BaseStats.Increase"]</span><span class="negative">@Text["Common.BaseStats.Decrease"]</span></div>
        }
        <div class="base-stat-bar-total">@Text["Common.BaseStats.GeneratedBst"] <strong>@GeneratedTotal</strong>@if (_mode == BaseStatDisplayMode.DeltaBars) { <span class="@GetDeltaClass(OriginalTotal, GeneratedTotal)">@FormatDelta(OriginalTotal, GeneratedTotal)</span> }</div>
    }
</section>
