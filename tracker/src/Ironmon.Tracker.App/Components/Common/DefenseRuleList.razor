@if (VisibleEffects.Count > 0)
{
    <section class="defense-protection-section">
        <h3>@Heading</h3>
        <div class="defense-protections">
            @foreach (DefenseEffectSnapshot effect in VisibleEffects)
            {
                @if (effect.Moves.Count > 0 || effect.HealingAmounts.Count > 0)
                {
                    <details class="defense-protection">
                        <summary>
                            @effect.Label
                            @if (effect.Moves.Count > 0) { <small>(@effect.Moves.Count)</small> }
                            @if (effect.Active is null) { <em>@Text["Defense.Conditional"]</em> }
                        </summary>
                        @foreach (var amounts in effect.HealingAmounts.GroupBy(amount => amount))
                        {
                            <p class="defense-recovery-amount">@amounts.Key@if (amounts.Count() > 1) { <small> ×@amounts.Count()</small> }</p>
                        }
                        @if (effect.Moves.Count > 0)
                        {
                            <ul class="defense-moves">@foreach (string move in effect.Moves) { <li>@move</li> }</ul>
                        }
                    </details>
                }
                else
                {
                    <span class="defense-protection-label">
                        @effect.Label
                        @if (effect.Active is null) { <em>@Text["Defense.Conditional"]</em> }
                    </span>
                }
            }
        </div>
    </section>
}
