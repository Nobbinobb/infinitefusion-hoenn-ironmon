@if (Dialog.Current is { } request)
{
    <ObsidianDialog Title="@request.Label" Eyebrow="@Text["Redesign.Sprite"]" Closed="CloseDialog">
        <div class="obsidian-sprite-preview"><img class="pokemon-sprite-image" style="@GetSizeStyle(request.Size)" src="@request.Source" alt="@request.Label" /></div>
    </ObsidianDialog>
}
