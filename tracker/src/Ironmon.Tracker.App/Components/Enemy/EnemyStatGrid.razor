<div class="enemy-stat-grid" aria-label="@Text["Enemy.Stats.EnemyStatAnnotations"]">
    @foreach ((string Name, EnemyStat Stat) stat in _stats)
    {
        <div class="enemy-stat-row">
            <span>@stat.Name</span>
            @if (Enemy is null)
            {
                <button type="button" disabled aria-label="@Text["Enemy.Stats.StatAnnotationUnavailable", stat.Name]">&nbsp;</button>
            }
            else
            {
                <button class="@GetAnnotationClass(stat.Stat)"
                        type="button"
                        aria-label="@Text["Enemy.Stats.StatAnnotation", stat.Name, GetAnnotationText(stat.Stat)]"
                        @onclick="() => CycleAnnotation(stat.Stat, true)"
                        @oncontextmenu="() => CycleAnnotation(stat.Stat, false)"
                        @oncontextmenu:preventDefault>
                    @GetAnnotationSymbol(stat.Stat)
                </button>
            }
        </div>
    }
</div>
