<div class="move-list" aria-label="@Text["Enemy.Moves.DiscoveredEnemyMoves"]">
    <div class="move-table-heading">
        <div class="move-table-title">
            <p class="section-label">@Text["Enemy.Moves.DiscoveredMovesHeading"]</p>
        </div>
        <span>@Text["Common.Move.PowerHeader"]</span>
        <span>@Text["Common.Move.PpHeader"]</span>
        <span>@Text["Common.Move.AccuracyHeader"]</span>
    </div>
    @foreach (int slot in _moveSlots)
    {
        ObservedMoveSnapshot? move = GetMoves().ElementAtOrDefault(slot - 1);
        @if (move is null)
        {
            <div class="move-placeholder unknown"><span>@Text["Enemy.Moves.UnknownMove"]</span><span>--</span></div>
        }
        else
        {
            <MoveRow Name="@move.Name"
                     Type="@move.Type"
                     Category="@move.Category"
                     Stab="@MovePresentation.HasStab(move.Type, move.Category, Enemy?.Types)"
                     Effectiveness="@MovePresentation.CalculateEffectiveness(move.Type, move.Category, PlayerTypes)"
                     PpText="@FormatObservedCurrentPp(move)"
                     CurrentPp="@move.PpAfterUse"
                     TotalPp="@move.TotalPp"
                     Power="@move.Power"
                     Accuracy="@move.Accuracy"
                     AccuracyStage="@(Enemy?.StatStages.Accuracy ?? 0)"
                     TargetEvasionStage="@PlayerEvasionStage"
                     Selected="() => SelectMove(move)" />
        }
    }
</div>

@if (_selectedMove is not null)
{
    <MoveDetailPanel Name="@_selectedMove.Name"
                     Type="@_selectedMove.Type"
                     Category="@_selectedMove.Category"
                     Description="@_selectedMove.Description"
                     Power="@_selectedMove.Power"
                     Accuracy="@_selectedMove.Accuracy"
                     PpText="@FormatObservedPp(_selectedMove)"
                     LearnedLevel="@_selectedMove.LearnedLevel"
                     Effectiveness="@MovePresentation.CalculateEffectiveness(_selectedMove.Type, _selectedMove.Category, PlayerTypes)"
                     Closed="CloseMove" />
}
