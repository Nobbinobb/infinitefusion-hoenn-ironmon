<section class="pokemon-card" role="tabpanel" aria-label="@Text["Enemy.Card.EnemyPokemon"]">
    @if (Enemies.Count > 1)
    {
        <nav class="enemy-selector" aria-label="@Text["Enemy.Card.OpposingPokemon"]">
            @for (int index = 0; index < Enemies.Count; index++)
            {
                EnemyPokemonSnapshot candidate = Enemies[index];
                int enemyNumber = index + 1;
                <button class="@GetEnemySelectorClass(candidate)" type="button" @onclick="() => SelectEnemy(candidate.EnemyId)">@Text["Enemy.Card.EnemyNumber", enemyNumber]</button>
            }
        </nav>
    }

    <div class="card-heading action-heading">
        <div class="sprite-placeholder enemy @(SelectedEnemy is null ? string.Empty : "live")" aria-hidden="true">
            @if (_spriteSource is not null)
            {
                <img src="@_spriteSource" alt="" />
            }
            else
            {
                <span>?</span>
            }
        </div>
        <div class="identity-placeholder">
            <p class="card-kicker">@Text["Enemy.Card.OpposingPokemonHeading"]</p>
            <h2 class="identity-name">
                <span>@GetName()</span>
                @if (SelectedEnemy is not null)
                {
                    <small>@Text["Enemy.Card.LevelValue", SelectedEnemy.Level]</small>
                }
            </h2>
            @if (SelectedEnemy is null)
            {
                <p>@Text["Enemy.Card.EnemyWaitingDescription"]</p>
            }
            else
            {
                <p class="typing-line">
                    @foreach (string type in SelectedEnemy.Types)
                    {
                        <span class="typing-type @MovePresentation.GetTypeColorClass(type)">@type</span>
                    }
                </p>
            }
        </div>
        <div class="identity-actions placeholder-content" aria-label="@Text["Enemy.Card.HiddenEnemyDetails"]">
            @if (GetAbilities().Count > 1)
            {
                <details class="compact-disclosure">
                    <summary>@Text["Enemy.Card.Ability"] <strong>@GetAbilities()[0].Name</strong><span>+@(GetAbilities().Count - 1)</span></summary>
                    <div class="disclosure-menu">
                        @foreach (AbilitySnapshot ability in GetAbilities())
                        {
                            <button type="button" @onclick="() => SelectAbility(ability)">@ability.Name</button>
                        }
                    </div>
                </details>
            }
            else if (GetAbilities().Count == 1)
            {
                <button class="identity-action-button" type="button" @onclick="() => SelectAbility(GetAbilities()[0])">@Text["Enemy.Card.Ability"] <strong>@GetAbilities()[0].Name</strong></button>
            }
            else
            {
                <span>@Text["Enemy.Card.Ability"] <strong>@GetFirstAbilityName()</strong></span>
            }
            <span>@Text["Enemy.Card.Item"] <strong>@(SelectedEnemy is null ? "--" : Text["Enemy.Card.Hidden"])</strong></span>
            <span class="identity-action-spacer" aria-hidden="true"></span>
        </div>
    </div>

    <div class="hp-block placeholder-content">
        <div><span>HP</span><strong>-- / --</strong></div>
        <div class="hp-bar unknown enemy" aria-label="@Text["Enemy.Card.EnemyHpUnknown"]"><span></span></div>
    </div>

    <div class="detail-strip placeholder-content" aria-label="@Text["Enemy.Card.HiddenEnemyCondition"]">
        <span>@(SelectedEnemy is null ? Text["Enemy.Card.StatusUnknown"] : Text["Enemy.Card.StatusHidden"])</span>
    </div>

    <EnemyStatGrid Enemy="@SelectedEnemy" />

    <div class="summary-row placeholder-content" aria-label="@Text["Enemy.Card.EnemySummary"]">
        <span>BST <strong>@GetBaseStatTotal()</strong></span>
        <span>@Text["Enemy.Card.Highest"] <strong>@FormatHighestLevel()</strong></span>
    </div>

    <EnemyMoveList Enemy="@SelectedEnemy" PlayerTypes="@PlayerTypes" />
</section>

@if (_selectedAbility is not null)
{
    <AbilityDetailPanel Ability="@_selectedAbility" Closed="CloseAbility" />
}
