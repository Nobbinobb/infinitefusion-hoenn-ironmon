<section class="obsidian obsidian-enemy" role="tabpanel" aria-label="@Text["Enemy.Card.EnemyPokemon"]">
    @if (Enemies.Count > 1)
    {
        <nav class="obsidian-enemy-selector" aria-label="@Text["Enemy.Card.OpposingPokemon"]">
            @for (int index = 0; index < Enemies.Count; index++)
            {
                EnemyPokemonSnapshot candidate = Enemies[index];
                int enemyNumber = index + 1;
                <button @key="candidate.EnemyId" type="button" aria-pressed="@((candidate.EnemyId == SelectedEnemy?.EnemyId).ToString().ToLowerInvariant())" @onclick="() => SelectEnemy(candidate.EnemyId)">
                    <PokemonSprite GameRoot="@GameRoot" SpritePath="@candidate.SpritePath" Label="@candidate.SpeciesName" Size="35" Interactive="false" />
                    <span class="obsidian-enemy-option"><small>@Text["Enemy.Card.EnemyNumber", enemyNumber]</small><strong>@candidate.SpeciesName</strong></span>
                    <span class="obsidian-enemy-level">@Text["Enemy.Card.LevelValue", candidate.Level]</span>
                </button>
            }
        </nav>
    }
    <ObsidianIdentityPanel GameRoot="@GameRoot" SpritePath="@SelectedEnemy?.SpritePath" SpriteLabel="@GetName()" Name="@GetName()" Kicker="@Text[SelectedEnemy?.Fusion == true ? "Enemy.Card.OpposingFusionHeading" : "Enemy.Card.OpposingPokemonHeading"]" DetailsLabel="@Text["Enemy.Card.HiddenEnemyDetails"]">
        <Metadata>
            @if (SelectedEnemy is null)
            {
                <p class="obsidian-species">@Text["Enemy.Card.EnemyWaitingDescription"]</p>
            }
            else
            {
                <p class="obsidian-species">@Text["Enemy.Card.LevelValue", SelectedEnemy.Level]</p>
                <div class="obsidian-types">
                    @foreach (string type in SelectedEnemy.Types)
                    {
                        <button type="button" class="typing-type @MovePresentation.GetTypeColorClass(type)" title="@Text["Defense.OpenTypes"]" aria-label="@Text["Defense.OpenType", type]" @onclick="OpenDefense">@type</button>
                    }
                </div>
            }
        </Metadata>
        <Details>
            <button type="button" disabled="@(GetAbilities().Count == 0)" @onclick="OpenAbilities"><span>@Text["Enemy.Card.Ability"]</span><strong>@GetFirstAbilityName() @if (GetAbilities().Count > 1) { <em>+@(GetAbilities().Count - 1)</em> }</strong></button>
            <div class="obsidian-hidden-detail"><span>@Text["Enemy.Card.Item"]</span><strong>@(SelectedEnemy is null ? "--" : Text["Enemy.Card.Hidden"])</strong></div>
        </Details>
        <Health>
            <div class="obsidian-hp-caption"><span>HP <span class="obsidian-condition">@(SelectedEnemy is null ? Text["Enemy.Card.StatusUnknown"] : Text["Enemy.Card.StatusHidden"])</span></span><strong>-- / --</strong></div>
            <div class="obsidian-hp-track obsidian-unknown-hp" aria-label="@Text["Enemy.Card.EnemyHpUnknown"]"></div>
        </Health>
        <Footer>
            <span>@Text["Enemy.Card.Highest"] <strong>@FormatHighestLevel()</strong></span>
            @if (SelectedEnemy?.CatchChancePercent is double catchChance)
            {
                <span class="obsidian-catch">@Text["Enemy.Card.PokeBall"] <strong>@FormatCatchChance(catchChance)</strong></span>
            }
        </Footer>
    </ObsidianIdentityPanel>
    <EnemyStatNotes Enemy="@SelectedEnemy" />
    <EnemyMoveList @key="(BattleId, SelectedEnemy?.EnemyId)" Enemy="@SelectedEnemy" BattleId="@BattleId" PlayerTypes="@PlayerTypes" PlayerEvasionStage="@PlayerEvasionStage" />
</section>

@if (_defenseOpen && SelectedEnemy is not null)
{
    <ObsidianDefenseDialog Name="@GetName()" Defense="@SelectedEnemy.DefensiveOverview" Closed="CloseDefense" />
}
@if (_abilitiesOpen)
{
    <ObsidianDialog Title="@(GetAbilities().Count == 1 ? GetFirstAbilityName() : Text["Redesign.Enemy.ObservedAbilities"])" Eyebrow="@GetName()" Closed="CloseAbilities">
        @foreach (AbilitySnapshot ability in GetAbilities())
        {
            <section class="obsidian-ability-entry">
                @if (GetAbilities().Count > 1) { <h3>@ability.Name</h3> }
                <p class="detail-description">@ability.Description</p>
            </section>
        }
    </ObsidianDialog>
}
