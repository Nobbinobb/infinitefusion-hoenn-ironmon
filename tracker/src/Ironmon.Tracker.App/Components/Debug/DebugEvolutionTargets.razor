<section class="debug-data-section" aria-label="@Text["Debug.Inspector.Evolutions"]">
    @if (HasTargets())
    {
        <EvolutionCandidateLists SpeciesId="@Pokemon.SpeciesId"
                                 HasNormal="@(Pokemon.EvolutionTargets.Count > 0)"
                                 HasHead="@(Pokemon.HeadEvolutionTargets.Count > 0)"
                                 HasBody="@(Pokemon.BodyEvolutionTargets.Count > 0)"
                                 DebugMode="true"
                                 GameRoot="@GameRoot"
                                 Selected="@Selected" />
    }
    @if (HasGraph())
    {
        <EvolutionGraph Current="@GetCurrentEvolutionNode()"
                        Predecessors="@Pokemon.EvolutionPredecessors"
                        Targets="@Pokemon.EvolutionTargets"
                        HeadTargets="@Pokemon.HeadEvolutionTargets"
                        BodyTargets="@Pokemon.BodyEvolutionTargets"
                        GameRoot="@GameRoot"
                        Selected="@Selected" />
    }
    @if (!HasTargets() && !HasGraph())
    {
        <p class="lookup-message">@Text["Debug.Inspector.NoGeneratedEvolutionTargets"]</p>
    }
</section>
