<article class="debug-protocol" aria-label="@Text["Debug.Protocol.TrackerProtocolDiagnostics"]">
    <div class="debug-protocol-actions">
        <button type="button" @onclick="Refresh">@Text["Debug.Protocol.Refresh"]</button>
        @if (HasAnyDiagnosticGroup)
        {
            <button type="button" @onclick="CopyReportAsync">@Text["Debug.Protocol.CopyReport"]</button>
            <button type="button" @onclick="ExportReportAsync">@Text["Debug.Protocol.ExportReport"]</button>
        }
        @if (HasProtocolHistory)
        {
            <button type="button" @onclick="ClearHistory">@Text["Debug.Protocol.ClearHistory"]</button>
        }
    </div>

    @if (_status is not null)
    {
        <p class="debug-report-status" role="status">@_status</p>
    }

    @if (HasProtocolHistory && _lastProtocolError is not null)
    {
        <p class="lookup-error" role="alert">@_lastProtocolError</p>
    }

    @if (HasRawState)
    {
        <details class="debug-raw-section">
            <summary class="debug-raw-heading">
                <p class="section-label">@Text["Debug.Protocol.CurrentConnectionStateHeading"]</p>
                <button type="button" @onclick="CopyConnectionAsync" @onclick:stopPropagation="true">@Text["Debug.Protocol.Copy"]</button>
            </summary>
            <pre class="debug-raw-value">@_connectionJson</pre>
        </details>

        <details class="debug-raw-section">
            <summary class="debug-raw-heading">
                <p class="section-label">@Text["Debug.Protocol.CurrentTrackerStateHeading"]</p>
                <button type="button" @onclick="CopyRunStateAsync" @onclick:stopPropagation="true">@Text["Debug.Protocol.Copy"]</button>
            </summary>
            <pre class="debug-raw-value">@_runStateJson</pre>
        </details>
    }

    @if (HasPersistedKnowledge)
    {
        <details class="debug-raw-section">
            <summary class="debug-raw-heading">
                <p class="section-label">@Text["Debug.Protocol.PersistedKnowledgeHeading"]</p>
                <button type="button" @onclick="CopyKnowledgeAsync" @onclick:stopPropagation="true">@Text["Debug.Protocol.Copy"]</button>
            </summary>
            <pre class="debug-raw-value">@_knowledgeJson</pre>
        </details>
    }

    @if (HasProtocolHistory)
    {
        <section class="debug-history" aria-label="@Text["Debug.Protocol.ConnectionAndProtocolHistory"]">
            <header class="debug-raw-heading">
                <p class="section-label">@Text["Debug.Protocol.ConnectionAndProtocolHistoryHeading"]</p>
                <span class="debug-entry-meta">@_entries.Count retained</span>
            </header>
            @if (_entries.Count == 0)
            {
                <p class="lookup-message">@Text["Debug.Protocol.NoDiagnosticEntries"]</p>
            }
            @foreach (TrackerDiagnosticEntry entry in _entries.Reverse())
            {
                <details class="debug-history-entry">
                    <summary class="debug-entry-heading">
                        <div>
                            <p><strong>@entry.Name</strong></p>
                            <span class="debug-entry-meta">@entry.Direction · @entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</span>
                        </div>
                        <button type="button" @onclick="() => CopyEntryAsync(entry)" @onclick:stopPropagation="true">@Text["Debug.Protocol.Copy"]</button>
                    </summary>
                    <pre class="debug-raw-value">@entry.RawValue</pre>
                </details>
            }
        </section>
    }
</article>
