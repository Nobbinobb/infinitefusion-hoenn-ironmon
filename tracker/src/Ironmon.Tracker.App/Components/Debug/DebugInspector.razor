<section class="pokemon-card debug-view" role="tabpanel" aria-label="@Text["Debug.Inspector.AuthorizedDebugInspector"]">
    <header class="debug-heading">
        <div>
            <p class="card-kicker">@Text["Debug.Inspector.DevelopmentModeHeading"]</p>
            <h2>@Text["Debug.Inspector.IronmonInspector"]</h2>
        </div>
        <span class="debug-authorized">@Text["Debug.Inspector.Authorized"]</span>
    </header>

    <DebugInspectorTabs Pages="@_visiblePages" SelectedPage="@_selectedPage" SelectedPageChanged="SelectPageAsync" />

    @if (!HasAnyPage)
    {
        <div class="lookup-empty">
            <strong>@Text["Debug.Inspector.NoAuthorizedPages"]</strong>
            <p>@Text["Debug.Inspector.NoAuthorizedPagesDescription"]</p>
        </div>
    }
    else if (_selectedPage == DebugInspectorPage.Pokemon)
    {
        <DebugInspectionTargetSelector Player="@Player"
                                       Enemies="@Enemies"
                                       PlayerAvailable="@CanInspectPlayer"
                                       EnemiesAvailable="@CanInspectEnemies"
                                       SelectedTarget="@_selectedTarget"
                                       Loading="@_loading"
                                       SelectedTargetChanged="SelectTarget" />
    }

    @if (HasAnyPage && _selectedPage == DebugInspectorPage.Lookup)
    {
        <DebugActiveRunLookup GameRoot="@GameRoot" InitialSpeciesId="@_requestedLookupSpeciesId" />
    }
    else if (HasAnyPage && _selectedPage == DebugInspectorPage.Protocol)
    {
        <DebugProtocolDiagnostics />
    }
    else if (HasAnyPage && _error is not null)
    {
        <p class="lookup-error" role="alert">@_error</p>
    }
    else if (HasAnyPage && _loading && !_backgroundRefresh)
    {
        <p class="lookup-message">@Text["Debug.Inspector.ReadingDebugData"]</p>
    }
    else if (HasAnyPage && _selectedPage == DebugInspectorPage.Diagnostics)
    {
        @if (_diagnostics is not null)
        {
            <DebugRunDiagnostics Diagnostics="@_diagnostics" />
        }
        else
        {
            <p class="lookup-message">@Text["Debug.Inspector.RunDiagnosticsNotLoaded"]</p>
        }
    }
    else if (HasAnyPage && (_pokemon is null || _lookup is null))
    {
        <div class="lookup-empty">
            <strong>@Text["Debug.Inspector.NoPokemonInspected"]</strong>
            <p>@Text["Debug.Inspector.SelectAvailablePokemon"]</p>
        </div>
    }
    else if (HasAnyPage)
    {
        <PokemonLookupCard Pokemon="@_lookup"
                           Inspector="@_pokemon"
                           DebugMode="true"
                           DebugTarget="@SelectedDebugTarget"
                           DebugEnemyPosition="@SelectedDebugEnemyPosition"
                           GameRoot="@GameRoot"
                           InformationPageSelected="SelectPokemonInformationPageAsync"
                           PokemonSelected="OpenLookupAsync" />
    }
</section>
