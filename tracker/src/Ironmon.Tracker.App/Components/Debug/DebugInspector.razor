<section class="pokemon-card debug-view" role="tabpanel" aria-label="@Text["Debug.Inspector.AuthorizedDebugInspector"]">
    <header class="debug-heading">
        <div>
            <p class="card-kicker">@Text["Debug.Inspector.DevelopmentModeHeading"]</p>
            <h2>@Text["Debug.Inspector.IronmonInspector"]</h2>
        </div>
        <span class="debug-authorized">@Text["Debug.Inspector.Authorized"]</span>
    </header>

    <nav class="debug-pages" aria-label="@Text["Debug.Inspector.DebugInspectorPages"]">
        @if (CanShowPage(DebugInspectorPage.Pokemon))
        {
            <button type="button" class="@GetPageClass(DebugInspectorPage.Pokemon)" @onclick="() => SelectPageAsync(DebugInspectorPage.Pokemon)">@Text["Debug.Inspector.Pokemon"]</button>
        }
        @if (CanShowPage(DebugInspectorPage.Lookup))
        {
            <button type="button" class="@GetPageClass(DebugInspectorPage.Lookup)" @onclick="() => SelectPageAsync(DebugInspectorPage.Lookup)">@Text["Debug.Inspector.Lookup"]</button>
        }
        @if (CanShowPage(DebugInspectorPage.Diagnostics))
        {
            <button type="button" class="@GetPageClass(DebugInspectorPage.Diagnostics)" @onclick="() => SelectPageAsync(DebugInspectorPage.Diagnostics)">@Text["Debug.Inspector.RunDiagnostics"]</button>
        }
        @if (CanShowPage(DebugInspectorPage.Protocol))
        {
            <button type="button" class="@GetPageClass(DebugInspectorPage.Protocol)" @onclick="() => SelectPageAsync(DebugInspectorPage.Protocol)">@Text["Debug.Inspector.Protocol"]</button>
        }
    </nav>

    @if (!HasAnyPage)
    {
        <div class="lookup-empty">
            <strong>@Text["Debug.Inspector.NoAuthorizedPages"]</strong>
            <p>@Text["Debug.Inspector.NoAuthorizedPagesDescription"]</p>
        </div>
    }
    else if (_selectedPage == DebugInspectorPage.Pokemon)
    {
        <div class="debug-target-controls">
            <label>
                Inspect
                <select value="@_selectedTarget" disabled="@(_loading || (Player is null && Enemies.Count == 0))" @onchange="SelectTarget" @onkeydown:stopPropagation="true">
                    @if (Player is not null && Connection.HasDiagnosticCapability(DiagnosticCapabilities.PokemonCurrentPlayer))
                    {
                        <option value="@DebugTargetIds.Player">@Text["Debug.Inspector.Player"] · @Player.Nickname</option>
                    }
                    @if (Connection.HasDiagnosticCapability(DiagnosticCapabilities.PokemonCurrentEnemies))
                    {
                        @foreach (EnemyPokemonSnapshot enemy in Enemies)
                        {
                            <option value="@($"{DebugTargetIds.Enemy}{DebugTargetIds.Separator}{enemy.Position}")">@Text["Debug.Inspector.EnemyNumber", (enemy.Position / DebugTargetIds.EnemyPositionStride) + DebugTargetIds.DisplayPositionOffset] · @enemy.SpeciesName</option>
                        }
                    }
                </select>
            </label>
        </div>
    }

    @if (HasAnyPage && _selectedPage == DebugInspectorPage.Lookup)
    {
        <DebugActiveRunLookup GameRoot="@GameRoot" InitialSpeciesId="@_requestedLookupSpeciesId" />
    }
    else if (HasAnyPage && _selectedPage == DebugInspectorPage.Protocol)
    {
        <DebugProtocolDiagnostics />
    }
    else if (HasAnyPage && _error is not null)
    {
        <p class="lookup-error" role="alert">@_error</p>
    }
    else if (HasAnyPage && _loading && !_backgroundRefresh)
    {
        <p class="lookup-message">@Text["Debug.Inspector.ReadingDebugData"]</p>
    }
    else if (HasAnyPage && _selectedPage == DebugInspectorPage.Diagnostics)
    {
        @if (_diagnostics is not null)
        {
            <DebugRunDiagnostics Diagnostics="@_diagnostics" />
        }
        else
        {
            <p class="lookup-message">@Text["Debug.Inspector.RunDiagnosticsNotLoaded"]</p>
        }
    }
    else if (HasAnyPage && (_pokemon is null || _lookup is null))
    {
        <div class="lookup-empty">
            <strong>@Text["Debug.Inspector.NoPokemonInspected"]</strong>
            <p>@Text["Debug.Inspector.SelectAvailablePokemon"]</p>
        </div>
    }
    else if (HasAnyPage)
    {
        <PokemonLookupCard Pokemon="@_lookup"
                           Inspector="@_pokemon"
                           DebugMode="true"
                           DebugTarget="@SelectedDebugTarget"
                           DebugEnemyPosition="@SelectedDebugEnemyPosition"
                           GameRoot="@GameRoot"
                           InformationPageSelected="SelectPokemonInformationPageAsync"
                           PokemonSelected="OpenLookupAsync" />
    }
</section>
