<article class="debug-overview" aria-label="@Text["Debug.Overview.InspectedPokemonOverview"]">
    <div class="card-heading action-heading">
        <div class="sprite-placeholder live" aria-hidden="true">
            @if (_spriteSource is not null)
            {
                <img src="@_spriteSource" alt="" />
            }
            else
            {
                <span>?</span>
            }
        </div>
        <div class="identity-placeholder">
            <p class="card-kicker">@(Pokemon.Fusion ? "FUSION" : "NORMAL POKEMON")</p>
                <h2 class="identity-name"><span>@Pokemon.Nickname</span><GenderIcon Gender="@Pokemon.Gender" /><small>@Text["Debug.Overview.LevelValue", Pokemon.Level]</small></h2>
            @if (HasDistinctNickname())
            {
                <p class="debug-species-name">@Pokemon.SpeciesName</p>
            }
            <p class="typing-line">
                @foreach (string type in Types)
                {
                    <span class="typing-type @MovePresentation.GetTypeColorClass(type)">@type</span>
                }
            </p>
        </div>
        <div class="identity-actions">
            <span>@Text["Debug.Overview.Item"] <strong>@(Pokemon.HeldItemName ?? Text["Debug.Overview.None"])</strong></span>
            <span>@Text["Debug.Overview.Form"] <strong>@GetFormText()</strong></span>
        </div>
    </div>

    <section class="debug-data-section">
        <p class="section-label">@Text["Debug.Overview.IdentityHeading"]</p>
        <dl class="debug-data-grid">
            <div><dt>@Text["Debug.Overview.PokemonId"]</dt><dd>@Pokemon.PokemonId</dd></div>
            <div><dt>@Text["Debug.Overview.SpeciesId"]</dt><dd>@Pokemon.SpeciesId</dd></div>
            <div><dt>@Text["Debug.Overview.AbilitySlot"]</dt><dd>@Pokemon.ActiveAbilitySlot (@Pokemon.ActiveAbilityIndex)</dd></div>
            <div><dt>@Text["Debug.Overview.Ability"]</dt><dd>@Pokemon.ActiveAbilityName · @Pokemon.ActiveAbilityId</dd></div>
        </dl>
    </section>

</article>
