<div class="@PickerCssClass" @ref="_pickerElement">
    <input type="text"
           value="@_query"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@(_open && !Disabled)"
           aria-controls="@_resultsId"
           autocomplete="off"
           disabled="@Disabled"
           @onfocus="OpenAsync"
           @onblur="Close"
           @oninput="HandleInput"
           @onkeydown="HandleKeyDown"
           @onkeydown:stopPropagation="true" />
    @if (AllowClear && !string.IsNullOrEmpty(SelectedId))
    {
        <button type="button" class="tools-picker-clear" aria-label="@ClearLabel" title="@ClearLabel" disabled="@Disabled" @onmousedown:preventDefault="true" @onclick="ClearAsync"><ObsidianIcon Kind="ObsidianIconKind.Close" /></button>
    }
    else
    {
        <span class="tools-picker-chevron"><ObsidianIcon Kind="ObsidianIconKind.ChevronDown" /></span>
    }
    @if (_open && !Disabled)
    {
        <div id="@_resultsId" class="development-picker-results" role="listbox" aria-label="@AriaLabel">
            @if (FilteredOptions.Count == 0)
            {
                <span class="development-picker-empty">@EmptyText</span>
            }
            else
            {
                @foreach (DebugDevelopmentCatalogEntry option in FilteredOptions)
                {
                    <button type="button" role="option" aria-selected="@(option.Id == SelectedId)" class="@(option.Id == SelectedId ? "selected" : null)" @onmousedown:preventDefault="true" @onclick="() => SelectAsync(option)">
                        <strong>@option.Name</strong>
                        <span>@option.Id</span>
                    </button>
                }
            }
        </div>
    }
</div>
