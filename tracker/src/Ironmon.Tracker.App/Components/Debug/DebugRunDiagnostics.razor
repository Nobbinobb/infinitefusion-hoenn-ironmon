<article class="debug-diagnostics" aria-label="@Text["Debug.Run.RunDiagnostics"]">
    <section class="debug-data-section">
        <p class="section-label">@Text["Debug.Run.RuntimeHeading"]</p>
        <dl class="debug-data-grid">
            <div><dt>@Text["Debug.Run.Game"]</dt><dd>@Diagnostics.Runtime.GameVersion</dd></div>
            <div><dt>Ironmon</dt><dd>@Diagnostics.Runtime.IronmonVersion</dd></div>
            <div><dt>@Text["Debug.Run.Protocol"]</dt><dd>@Diagnostics.Runtime.ProtocolVersion</dd></div>
            <div><dt>@Text["Debug.Run.Seed"]</dt><dd>@(Diagnostics.Runtime.RunSeed?.ToString() ?? Text["Debug.Run.None"])</dd></div>
            <div class="wide"><dt>@Text["Debug.Run.RunId"]</dt><dd>@(Diagnostics.Runtime.RunId ?? Text["Debug.Run.None"])</dd></div>
            <div class="wide"><dt>@Text["Debug.Run.BattleId"]</dt><dd>@(Diagnostics.Runtime.BattleId ?? Text["Debug.Run.None"])</dd></div>
        </dl>
    </section>

    @if (Diagnostics.Configuration is { } configuration)
    {
        <section class="debug-data-section">
            <p class="section-label">@Text["Debug.Run.ConfigurationHeading"]</p>
            <dl class="debug-data-grid">
                <div><dt>@Text["Debug.Run.Wild"]</dt><dd>@configuration.WildPolicy</dd></div>
                <div><dt>@Text["Debug.Run.Trainer"]</dt><dd>@configuration.TrainerPolicy</dd></div>
                <div class="wide"><dt>@Text["Debug.Run.Unfusion"]</dt><dd>@configuration.UnfusionSetting</dd></div>
            </dl>
        </section>
    }

    @if (Diagnostics.SpeciesGenerator is not null || Diagnostics.EvolutionGenerator is not null || Diagnostics.ItemGenerator is not null)
    {
        <section class="debug-data-section">
            <p class="section-label">@Text["Debug.Run.GeneratorsAndPoolsHeading"]</p>
            <dl class="debug-data-grid">
                @if (Diagnostics.SpeciesGenerator is { } speciesGenerator && Diagnostics.AbilityGenerator is { } abilityGenerator && Diagnostics.PlayerFusionGenerator is { } playerFusionGenerator && Diagnostics.Mappings is { } mappings)
                {
                    <div><dt>@Text["Debug.Run.CustomFusions"]</dt><dd>@playerFusionGenerator.PoolSize</dd></div>
                    <div><dt>@Text["Debug.Run.SpeciesSchema"]</dt><dd>@speciesGenerator.Version</dd></div>
                    <div><dt>@Text["Debug.Run.AbilitySchema"]</dt><dd>@abilityGenerator.Version</dd></div>
                    <div><dt>@Text["Debug.Run.BaseStatSchema"]</dt><dd>@(Diagnostics.BaseStatGenerator?.Version.ToString() ?? Text["Debug.Run.Legacy"])</dd></div>
                    <div><dt>@Text["Debug.Run.MoveSchema"]</dt><dd>@(Diagnostics.MoveAccessGenerator?.Version.ToString() ?? Text["Debug.Run.None"])</dd></div>
                    <div><dt>@Text["Debug.Run.AbilityPool"]</dt><dd>@abilityGenerator.PoolSize</dd></div>
                    <div><dt>@Text["Debug.Run.WildMappings"]</dt><dd>@mappings.Wild</dd></div>
                    <div><dt>@Text["Debug.Run.TrainerMappings"]</dt><dd>@mappings.Trainer</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.SpeciesFingerprint"]</dt><dd>@speciesGenerator.PoolFingerprint</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.FusionFingerprint"]</dt><dd>@playerFusionGenerator.PoolFingerprint</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.AbilityFingerprint"]</dt><dd>@abilityGenerator.PoolFingerprint</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.BaseStatFingerprint"]</dt><dd>@(Diagnostics.BaseStatGenerator?.SourceFingerprint ?? Text["Debug.Run.None"])</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.MoveFingerprint"]</dt><dd>@(Diagnostics.MoveAccessGenerator?.PoolFingerprint ?? Text["Debug.Run.None"])</dd></div>
                }
                @if (Diagnostics.EvolutionGenerator is { } evolutionGenerator)
                {
                    <div><dt>@Text["Debug.Run.EvolutionSchema"]</dt><dd>@evolutionGenerator.Version</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.EvolutionFingerprint"]</dt><dd>@evolutionGenerator.TargetFingerprint</dd></div>
                }
                @if (Diagnostics.ItemGenerator is { } itemGenerator)
                {
                    <div><dt>@Text["Debug.Run.ItemSchema"]</dt><dd>@itemGenerator.Version</dd></div>
                    <div><dt>@Text["Debug.Run.ItemRules"]</dt><dd>@itemGenerator.RulesVersion</dd></div>
                    <div><dt>@Text["Debug.Run.GroundItemPool"]</dt><dd>@itemGenerator.GroundPoolSize</dd></div>
                    <div><dt>@Text["Debug.Run.TmGiftPool"]</dt><dd>@itemGenerator.TmPoolSize</dd></div>
                    <div><dt>@Text["Debug.Run.ShopPolicy"]</dt><dd>@itemGenerator.ShopPolicyVersion</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.ItemBans"]</dt><dd>@string.Join(", ", itemGenerator.ResultBans)</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.GroundItemFingerprint"]</dt><dd>@itemGenerator.GroundPoolFingerprint</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.TmGiftFingerprint"]</dt><dd>@itemGenerator.TmPoolFingerprint</dd></div>
                    <div class="wide"><dt>@Text["Debug.Run.ItemBanFingerprint"]</dt><dd>@itemGenerator.ResultBanFingerprint</dd></div>
                }
                else
                {
                    <div><dt>@Text["Debug.Run.ItemSchema"]</dt><dd>@Text["Debug.Run.Legacy"]</dd></div>
                }
            </dl>
        </section>
    }
</article>
