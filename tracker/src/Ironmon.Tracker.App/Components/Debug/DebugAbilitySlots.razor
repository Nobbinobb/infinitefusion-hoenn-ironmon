<article class="debug-abilities" aria-label="@Text["Debug.Abilities.InspectedAbilitySlots"]">
    @foreach (DebugAbilitySlotGroup group in GetVisibleGroups())
    {
        <section class="debug-ability-group">
            <header>
                <p class="section-label">@GetGroupName(group)</p>
                <span>@Text["Debug.Abilities.SlotCount", GetSlots(group).Count]</span>
            </header>
            <div class="debug-ability-list">
                @foreach (DebugAbilitySlotSnapshot slot in GetSlots(group))
                {
                    <article class="debug-ability-slot @(slot.Active ? "active" : string.Empty)">
                        <div class="debug-slot-heading">
                            <strong>@GetSlotName(slot)</strong>
                            @if (slot.Active)
                            {
                                <span>@Text["Debug.Abilities.ActiveHeading"]</span>
                            }
                        </div>
                        <div class="debug-slot-ability">
                            <strong>@slot.AbilityName</strong>
                            <code>@slot.AbilityId</code>
                        </div>
                        <dl>
                            <div><dt>@Text["Debug.Abilities.Eligibility"]</dt><dd>@GetEligibilityName(slot.Eligibility)</dd></div>
                            @if (slot.OriginalAbilityId is not null)
                            {
                                <div><dt>@Text["Debug.Abilities.Original"]</dt><dd>@slot.OriginalAbilityName · @slot.OriginalAbilityId</dd></div>
                            }
                            @if (slot.Source is not null)
                            {
                                <div><dt>@Text["Debug.Abilities.Source"]</dt><dd>@slot.Source</dd></div>
                            }
                            @if (slot.SourceAbilityId is not null)
                            {
                                <div><dt>@Text["Debug.Abilities.From"]</dt><dd>@slot.SourceAbilityName · @slot.SourceAbilityId</dd></div>
                            }
                        </dl>
                        @if (slot.RestrictedSourceReplaced)
                        {
                            <p class="debug-replacement">@Text["Debug.Abilities.RestrictedAbilityReplaced"]</p>
                        }
                    </article>
                }
            </div>
        </section>
    }
</article>
