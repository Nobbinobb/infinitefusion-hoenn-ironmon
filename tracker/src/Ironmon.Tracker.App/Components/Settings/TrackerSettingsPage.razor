<section class="tracker-settings" aria-label="@Text["Settings.Page.Settings"]">
    <header class="settings-heading">
        <div>
            <p class="card-kicker">@Text["Settings.Page.TrackerPreferences"]</p>
            <h2>@Text["Settings.Page.Settings"]</h2>
        </div>
    </header>

    <details class="settings-group">
        <summary>
            <span>
                <strong>@Text["Settings.Starter.Group"]</strong>
                <small>@Text["Settings.Starter.GroupDescription"]</small>
            </span>
        </summary>
        <div class="settings-group-content">
            <label class="settings-option">
                <span>
                    <strong>@Text["Settings.Starter.AutoSelectStarter"]</strong>
                    <small>@Text["Settings.Starter.AutoSelectDescription"]</small>
                </span>
                <input type="checkbox" checked="@AutoSelectStarter" @onchange="HandleAutoSelectChanged" />
            </label>

            <label class="settings-number-option">
                <span>
                    <strong>@Text["Settings.Starter.MaximumBst"]</strong>
                    <small>@Text["Settings.Starter.MaximumBstDescription"]</small>
                </span>
                <input type="number"
                       min="@StarterSelectionConstants.MinimumBaseStatTotal"
                       max="@StarterSelectionConstants.MaximumBaseStatTotal"
                       value="@MaximumStarterBaseStatTotal"
                       placeholder="@Text["Settings.Starter.MaximumBstPlaceholder"]"
                       @onchange="HandleMaximumBstChanged" />
                @if (!string.IsNullOrWhiteSpace(_maximumBstError))
                {
                    <small class="settings-validation">@_maximumBstError</small>
                }
            </label>
        </div>
    </details>

    <details class="settings-group">
        <summary>
            <span>
                <strong>@Text["Settings.EvolutionGraph.Group"]</strong>
                <small>@Text["Settings.EvolutionGraph.GroupDescription"]</small>
            </span>
        </summary>
        <div class="settings-group-content">
            <label class="settings-number-option">
                <span>
                    <strong>@Text["Settings.EvolutionGraph.ExpansionDepth"]</strong>
                    <small>@Text["Settings.EvolutionGraph.ExpansionDepthDescription"]</small>
                </span>
                <input type="number"
                       min="@EvolutionGraphSettings.MinimumExpansionDepth"
                       max="@EvolutionGraphSettings.MaximumExpansionDepth"
                       value="@EvolutionGraphSettings.ExpansionDepth"
                       @onchange="HandleExpansionDepthChanged" />
                @if (!string.IsNullOrWhiteSpace(_graphDepthError))
                {
                    <small class="settings-validation">@_graphDepthError</small>
                }
            </label>

            <label class="settings-number-option">
                <span>
                    <strong>@Text["Settings.EvolutionGraph.NodesPerRow"]</strong>
                    <small>@Text["Settings.EvolutionGraph.NodesPerRowDescription"]</small>
                </span>
                <input type="number"
                       min="@EvolutionGraphSettings.MinimumNodesPerRow"
                       max="@EvolutionGraphSettings.MaximumNodesPerRow"
                       value="@EvolutionGraphSettings.NodesPerRow"
                       @onchange="HandleNodesPerRowChanged" />
                @if (!string.IsNullOrWhiteSpace(_nodesPerRowError))
                {
                    <small class="settings-validation">@_nodesPerRowError</small>
                }
            </label>
        </div>
    </details>

    <details class="settings-group">
        <summary>
            <span>
                <strong>@Text["Settings.Sprites.Group"]</strong>
                <small>@Text["Settings.Sprites.GroupDescription"]</small>
            </span>
        </summary>
        <div class="settings-group-content">
            <section class="sprite-download-card">
                <span>
                    <strong>@Text["Settings.Sprites.DownloadCustom"]</strong>
                    <small>@Text["Settings.Sprites.DownloadDescription"]</small>
                    <small class="settings-warning">@Text["Settings.Sprites.DownloadWarning"]</small>
                </span>

                @if (_spriteInstallRunning && _spriteInstallProgress is not null)
                {
                    <progress max="@Math.Max(1, _spriteInstallProgress.TotalSheetCount)" value="@_spriteInstallProgress.CompletedSheetCount"></progress>
                    <small>@Text["Settings.Sprites.Progress", _spriteInstallProgress.CompletedSheetCount, _spriteInstallProgress.TotalSheetCount, FormatBytes(_spriteInstallProgress.DownloadedBytes), _spriteInstallProgress.FailedSheetCount, _spriteInstallProgress.UnavailableSheetCount]</small>
                    <button type="button" class="secondary" @onclick="CancelSpriteInstall">@Text["Settings.Sprites.Cancel"]</button>
                }
                else if (_showSpriteInstallConfirmation && _spriteInstallPlan is not null)
                {
                    <div class="sprite-download-confirmation">
                        <p>@Text["Settings.Sprites.Confirmation", _spriteInstallPlan.PendingSheetCount, _spriteInstallPlan.ExistingSheetCount, _spriteInstallPlan.TotalSheetCount]</p>
                        @if (_spriteInstallPlan.UnavailableSheetCount > 0)
                        {
                            <p>@Text["Settings.Sprites.SkippedUnavailable", _spriteInstallPlan.UnavailableSheetCount]</p>
                        }
                        <div>
                            <button type="button" @onclick="StartSpriteInstallAsync">@Text["Settings.Sprites.Start"]</button>
                            <button type="button" class="secondary" @onclick="CancelSpriteReview">@Text["Settings.Sprites.Cancel"]</button>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" disabled="@_spriteInstallPreparing" @onclick="ReviewSpriteInstallAsync">@(_spriteInstallPreparing ? Text["Settings.Sprites.Preparing"] : Text["Settings.Sprites.Review"])</button>
                    <button type="button" class="secondary" disabled="@_spriteInstallPreparing" @onclick="ReviewUnavailableSpritesAsync">@Text["Settings.Sprites.RecheckUnavailable"]</button>
                    <small>@Text["Settings.Sprites.RecheckDescription"]</small>
                }

                @if (!string.IsNullOrWhiteSpace(_spriteInstallStatus))
                {
                    <p class="settings-status" role="status">@_spriteInstallStatus</p>
                }
            </section>
        </div>
    </details>

    <details class="settings-group favorite-settings">
        <summary>
            <span>
                <strong>@Text["Settings.Favorites.FavoriteClause"]</strong>
                <small>@Text["Settings.Favorites.Description"]</small>
            </span>
        </summary>
        <div class="settings-group-content">
            <input class="favorite-search" type="search" value="@_query" @oninput="HandleSearchInput" placeholder="@Text["Settings.Favorites.SearchPlaceholder"]" autocomplete="off" />

        @if (_searching)
        {
            <p class="settings-status">@Text["Settings.Favorites.Searching"]</p>
        }
        else if (!string.IsNullOrWhiteSpace(_searchError))
        {
            <p class="settings-status">@_searchError</p>
        }
        else if (_matches.Count > 0)
        {
            <div class="favorite-suggestions">
                @foreach (PokemonSearchMatch match in _matches)
                {
                    <button type="button" disabled="@IsFavorite(match.SpeciesId)" @onclick="() => AddFavoriteAsync(match)">
                        <span>@match.SpeciesName</span>
                        <small>@(IsFavorite(match.SpeciesId) ? Text["Settings.Favorites.Added"] : Text["Settings.Favorites.Add"])</small>
                    </button>
                }
            </div>
        }

            <div class="favorite-list-heading">
                <strong>@Text["Settings.Favorites.YourFavorites"]</strong>
                <small>@Text["Settings.Favorites.Count", _favorites.Count]</small>
            </div>
            @if (_favorites.Count == 0)
            {
                <p class="favorite-empty">@Text["Settings.Favorites.Empty"]</p>
            }
            else
            {
                <div class="favorite-list">
                    @foreach (PokemonSearchMatch favorite in PagedFavorites)
                    {
                        <div>
                            <span>@favorite.SpeciesName</span>
                            <button type="button" @onclick="() => RemoveFavoriteAsync(favorite.SpeciesId)">@Text["Settings.Favorites.Remove"]</button>
                        </div>
                    }
                </div>
                @if (FavoritePageCount > 1)
                {
                    <nav class="favorite-pager" aria-label="@Text["Settings.Favorites.Pages"]">
                        <button type="button" disabled="@(_favoritePage == 0)" @onclick="PreviousFavoritePage">@Text["Settings.Favorites.Previous"]</button>
                        <span>@Text["Settings.Favorites.Page", _favoritePage + 1, FavoritePageCount]</span>
                        <button type="button" disabled="@(_favoritePage + 1 >= FavoritePageCount)" @onclick="NextFavoritePage">@Text["Settings.Favorites.Next"]</button>
                    </nav>
                }
            }
        </div>
    </details>

    @if (!string.IsNullOrWhiteSpace(Status))
    {
        <p class="settings-status" role="status">@Status</p>
    }
</section>
