<section class="tracker-settings seeded-run-page" aria-label="@Text["Seeds.Page.Title"]">
    <header class="settings-heading">
        <div>
            <p class="card-kicker">@Text["Seeds.Page.Kicker"]</p>
            <h2>@Text["Seeds.Page.Title"]</h2>
        </div>
    </header>

    <div class="access-state @(CanUseActiveRun ? "active" : "none")" role="status">
        <strong>@(CanUseActiveRun ? Text["Seeds.State.Available"] : Text["Seeds.State.Unavailable"])</strong>
        <span>@(CanUseActiveRun ? Text["Seeds.State.AvailableDescription"] : Text["Seeds.State.UnavailableDescription"])</span>
    </div>

    <SeedTokenExportPanel RecipeProvider="ExportRecipeAsync"
                          Title="@Text["Seeds.Export.Title"]"
                          Description="@Text["Seeds.Export.Description"]"
                          Disabled="@(OperationLocked || !CanUseActiveRun)"
                          BusyChanged="HandleExportBusyChanged" />

    <section class="seed-action-card">
        <div>
            <strong>@Text["Seeds.Import.Title"]</strong>
            <small>@Text["Seeds.Import.Description"]</small>
        </div>
        <textarea value="@_importToken" @oninput="UpdateImportToken" rows="4" maxlength="@SeedTokenConstants.MaximumTokenLength" placeholder="@Text["Seeds.Import.Placeholder"]"></textarea>
        <div class="access-input-actions">
            <label class="access-file-button">
                @Text["Seeds.Import.LoadFile"]
                <InputFile OnChange="LoadImportFileAsync" accept=".ironmon-seed" />
            </label>
            <button type="button" class="access-primary" disabled="@(OperationLocked || !CanUseActiveRun || string.IsNullOrWhiteSpace(_importToken))" @onclick="ValidateImportAsync">@Text["Seeds.Import.Validate"]</button>
        </div>
    </section>

    @if (_validatedToken is not null)
    {
        <section class="seed-confirmation">
            <strong>@Text["Seeds.Confirm.Title"]</strong>
            <dl class="access-details">
                <div><dt>@Text["Seeds.Details.Seed"]</dt><dd><code>@_validatedToken.Seed</code></dd></div>
                <div><dt>@Text["Seeds.Details.Mode"]</dt><dd>@_validatedToken.DataMode</dd></div>
                <div><dt>@Text["Seeds.Details.GameVersion"]</dt><dd>@_validatedToken.GameVersion</dd></div>
                <div><dt>@Text["Seeds.Details.IronmonVersion"]</dt><dd>@_validatedToken.IronmonVersion</dd></div>
            </dl>
            <p class="access-warning">@Text["Seeds.Confirm.Warning"]</p>
            <button type="button" class="seed-destructive" disabled="@(OperationLocked || !CanUseActiveRun)" @onclick="ConfirmImportAsync">@Text["Seeds.Confirm.Button"]</button>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <p class="access-message @(_operationSucceeded ? "success" : "error")" role="status">@_operationMessage</p>
    }
</section>
