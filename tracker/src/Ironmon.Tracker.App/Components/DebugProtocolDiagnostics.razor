<article class="debug-protocol" aria-label="Tracker protocol diagnostics">
    <div class="debug-protocol-actions">
        <button type="button" @onclick="Refresh">Refresh</button>
        <button type="button" @onclick="CopyReportAsync">Copy report</button>
        <button type="button" @onclick="ExportReportAsync">Export report</button>
        <button type="button" @onclick="ClearHistory">Clear history</button>
    </div>

    @if (_status is not null)
    {
        <p class="debug-report-status" role="status">@_status</p>
    }

    @if (_lastProtocolError is not null)
    {
        <p class="lookup-error" role="alert">@_lastProtocolError</p>
    }

    <section class="debug-raw-section">
        <header class="debug-raw-heading">
            <p class="section-label">CURRENT CONNECTION STATE</p>
            <button type="button" @onclick="CopyConnectionAsync">Copy</button>
        </header>
        <pre class="debug-raw-value">@_connectionJson</pre>
    </section>

    <section class="debug-raw-section">
        <header class="debug-raw-heading">
            <p class="section-label">CURRENT TRACKER STATE</p>
            <button type="button" @onclick="CopyRunStateAsync">Copy</button>
        </header>
        <pre class="debug-raw-value">@_runStateJson</pre>
    </section>

    <section class="debug-raw-section">
        <header class="debug-raw-heading">
            <p class="section-label">PERSISTED KNOWLEDGE</p>
            <button type="button" @onclick="CopyKnowledgeAsync">Copy</button>
        </header>
        <pre class="debug-raw-value">@_knowledgeJson</pre>
    </section>

    <section class="debug-history" aria-label="Connection and protocol history">
        <header class="debug-raw-heading">
            <p class="section-label">CONNECTION AND PROTOCOL HISTORY</p>
            <span class="debug-entry-meta">@_entries.Count retained</span>
        </header>
        @if (_entries.Count == 0)
        {
            <p class="lookup-message">No diagnostic entries recorded.</p>
        }
        @foreach (TrackerDiagnosticEntry entry in _entries.Reverse())
        {
            <article class="debug-history-entry">
                <header class="debug-entry-heading">
                    <div>
                        <p><strong>@entry.Name</strong></p>
                        <span class="debug-entry-meta">@entry.Direction · @entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</span>
                    </div>
                    <button type="button" @onclick="() => CopyEntryAsync(entry)">Copy</button>
                </header>
                <pre class="debug-raw-value">@entry.RawValue</pre>
            </article>
        }
    </section>
</article>
