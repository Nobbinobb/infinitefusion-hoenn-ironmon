@page "/"

<PageTitle>@Text["App.Shell.AppTitle"]</PageTitle>

<main class="tracker-shell" tabindex="0" @onkeydown="HandleKeyDown">
    <header class="tracker-header">
        <div>
            <p class="eyebrow">@Text["App.Shell.HomeEyebrow"]</p>
            <h1>@Text["App.Shell.HomeHeading"]</h1>
        </div>
        <div class="connection-state" role="status" title="@GetConnectionDetail()">
            <span class="@GetConnectionDotClass()" aria-hidden="true"></span>
            <span>@GetConnectionText()</span>
        </div>
    </header>

    <nav class="@GetViewTabsClass()" aria-label="@Text["App.Shell.TrackerViewsLabel"]" role="tablist">
        <button class="@GetTabClass(TrackerView.Player)"
                type="button"
                role="tab"
                aria-selected="@(_selectedView == TrackerView.Player)"
                @onclick="() => SelectView(TrackerView.Player)">
            <span class="tab-key">P</span>
            @Text["App.Shell.Player"]
        </button>
        <button class="@GetTabClass(TrackerView.Enemy)"
                type="button"
                role="tab"
                aria-selected="@(_selectedView == TrackerView.Enemy)"
                @onclick="() => SelectView(TrackerView.Enemy)">
            <span class="tab-key">E</span>
            @Text["App.Shell.Enemy"]
        </button>
        <button class="@GetTabClass(TrackerView.Lookup)"
                type="button"
                role="tab"
                aria-selected="@(_selectedView == TrackerView.Lookup)"
                @onclick="() => SelectView(TrackerView.Lookup)">
            <span class="tab-key">L</span>
            @Text["App.Shell.Lookup"]
        </button>
        @if (TrackerConnection.DebugAuthorized)
        {
            <button class="@GetTabClass(TrackerView.Debug)"
                    type="button"
                    role="tab"
                    aria-selected="@(_selectedView == TrackerView.Debug)"
                    @onclick="() => SelectView(TrackerView.Debug)">
                <span class="tab-key">D</span>
                @Text["App.Shell.Debug"]
            </button>
        }
    </nav>

    @if (_selectedView == TrackerView.Player)
    {
        <PlayerCard Player="@_run.Player" GameRoot="@_connection.Game?.GameRoot" TargetTypes="@GetSelectedEnemy()?.Types" />
    }
    else if (_selectedView == TrackerView.Enemy)
    {
        <EnemyCard Enemies="@_run.Enemies"
                   PlayerTypes="@_run.Player?.Types"
                   GameRoot="@_connection.Game?.GameRoot"
                   @bind-SelectedEnemyId="_selectedEnemyId" />
    }
    else if (_selectedView == TrackerView.Lookup)
    {
        <PostRunLookup GameRoot="@_connection.Game?.GameRoot" />
    }
    else
    {
        <DebugInspector Player="@_run.Player" Enemies="@_run.Enemies" GameRoot="@_connection.Game?.GameRoot" />
    }

    <footer class="tracker-footer">
        <span>@Text["App.Shell.LocalConnection"]</span>
        <span>
            <kbd>P</kbd> @Text["App.Shell.Player"]&nbsp;&nbsp;<kbd>E</kbd> @Text["App.Shell.Enemy"]&nbsp;&nbsp;<kbd>L</kbd> @Text["App.Shell.Lookup"]
            @if (TrackerConnection.DebugAuthorized)
            {
                <text>&nbsp;&nbsp;<kbd>D</kbd> @Text["App.Shell.Debug"]</text>
            }
        </span>
    </footer>
</main>
