@page "/"

<PageTitle>@Text["App.Shell.AppTitle"]</PageTitle>

<main class="tracker-shell @(_accessOpen ? "obsidian-access-shell" : null) @(!_accessOpen ? "obsidian" : null)" tabindex="0" @onkeydown="HandleKeyDown">
    <header class="tracker-header">
        <div class="connection-state" role="status" title="@GetConnectionDetail()" aria-label="@GetConnectionAccessibleText()">
            <span class="@GetConnectionDotClass()" aria-hidden="true"></span>
            <span>@GetConnectionText()</span>
            @if (_obtainabilityProgress.Status == TrackerObtainabilityProgressStatus.Running)
            {
                <span class="connection-work-spinner" aria-hidden="true"></span>
            }
        </div>
        @if (!_accessOpen && !_settingsOpen && !_seedsOpen && _selectedView == TrackerView.Archive)
        {
            <SectionOutlet SectionName="archive-navigation" />
        }
        @if (_accessOpen)
        {
            <SectionOutlet SectionName="diagnostic-target-navigation" />
        }
        <div class="header-actions" role="group" aria-label="@Text["App.Shell.ToolsLabel"]">
            <button class="@GetAccessButtonClass()" type="button" aria-label="@Text["Access.Page.Open"]" aria-pressed="@(_accessOpen ? "true" : "false")" title="@Text["Access.Page.Title"]" @onclick="ToggleAccess">
                <span class="header-action-icon" aria-hidden="true">&#xE192;</span>
            </button>
            <button class="@GetSeedsButtonClass()" type="button" aria-label="@Text["Seeds.Page.Open"]" aria-pressed="@(_seedsOpen ? "true" : "false")" title="@Text["Seeds.Page.Title"]" @onclick="ToggleSeeds">
                <ObsidianIcon Kind="ObsidianIconKind.Sprout" />
            </button>
            <button class="@GetSettingsButtonClass()" type="button" aria-label="@Text["Settings.Page.OpenSettings"]" aria-pressed="@(_settingsOpen ? "true" : "false")" title="@Text["Settings.Page.Settings"]" @onclick="ToggleSettings">
                <span class="header-action-icon" aria-hidden="true">&#xE713;</span>
            </button>
        </div>
    </header>

    <nav class="@TrackerUiConstants.ViewTabsCssClass" aria-label="@Text["App.Shell.TrackerViewsLabel"]" role="tablist">
        <button class="@GetTabClass(TrackerView.Player)"
                type="button"
                role="tab"
                title="Ctrl+1"
                aria-selected="@(!_accessOpen && !_settingsOpen && !_seedsOpen && _selectedView == TrackerView.Player ? "true" : "false")"
                @onclick="() => SelectView(TrackerView.Player)">
            <span class="tab-key" aria-hidden="true">1</span>
            @Text["App.Shell.Player"]
        </button>
        <button class="@GetTabClass(TrackerView.Enemy)"
                type="button"
                role="tab"
                title="Ctrl+2"
                aria-selected="@(!_accessOpen && !_settingsOpen && !_seedsOpen && _selectedView == TrackerView.Enemy ? "true" : "false")"
                @onclick="() => SelectView(TrackerView.Enemy)">
            <span class="tab-key" aria-hidden="true">2</span>
            @Text["App.Shell.Enemy"]
        </button>
        <button class="@GetTabClass(TrackerView.Lookup)"
                type="button"
                role="tab"
                title="Ctrl+3"
                aria-selected="@(!_accessOpen && !_settingsOpen && !_seedsOpen && _selectedView == TrackerView.Lookup ? "true" : "false")"
                @onclick="() => SelectView(TrackerView.Lookup)">
            <span class="tab-key" aria-hidden="true">3</span>
            @Text["App.Shell.Lookup"]
        </button>
        <button class="@GetTabClass(TrackerView.Archive)"
                type="button"
                role="tab"
                title="Ctrl+4"
                aria-selected="@(!_accessOpen && !_settingsOpen && !_seedsOpen && _selectedView == TrackerView.Archive ? "true" : "false")"
                @onclick="() => SelectView(TrackerView.Archive)">
            <span class="tab-key" aria-hidden="true">4</span>
            @Text["App.Shell.Archive"]
        </button>
    </nav>

    @if (_accessOpen)
    {
        <DiagnosticToolsPage Player="@_run.Player" Enemies="@_run.Enemies" GameRoot="@_connection.Game?.GameRoot" />
    }
    else if (_seedsOpen)
    {
        <SeededRunPage />
    }
    else if (_settingsOpen)
    {
        <TrackerSettingsPage AutoSelectStarter="@_autoSelectStarter" AutoSelectStarterChanged="HandleAutoSelectStarterChanged" MaximumStarterBaseStatTotal="@_maximumStarterBaseStatTotal" MaximumStarterBaseStatTotalChanged="HandleMaximumStarterBaseStatTotalChanged" FavoriteSpeciesIdsChanged="HandleFavoriteSpeciesIdsChanged" Status="@_settingsStatus" />
    }
    else if (_selectedView == TrackerView.Player)
    {
        @if (_run.StarterSelection is not null)
        {
            <StarterSelection Selection="@_run.StarterSelection" GameRoot="@_connection.Game?.GameRoot" />
        }
        else
        {
            <PlayerCard Player="@_run.Player"
                        Badges="@_connection.CurrentState?.Badges"
                        GameRoot="@_connection.Game?.GameRoot"
                        TargetTypes="@GetMoveTargetEnemy()?.Types"
                        TargetEvasionStage="@(GetMoveTargetEnemy()?.StatStages.Evasion ?? 0)"
                        InBattle="@(_run.Battle is not null)"
                        BattleId="@_run.Battle?.BattleId"
                        TargetPosition="@GetSelectedEnemy()?.Position" />
        }
    }
    else if (_selectedView == TrackerView.Enemy)
    {
        <EnemyCard Enemies="@_run.Enemies"
                   Badges="@_connection.CurrentState?.Badges"
                   BattleId="@_run.Battle?.BattleId"
                   PlayerTypes="@_run.Player?.Types"
                   PlayerEvasionStage="@(_run.Player?.StatStages.Evasion ?? 0)"
                   GameRoot="@_connection.Game?.GameRoot"
                   @bind-SelectedEnemyId="_selectedEnemyId" />
    }
    else if (_selectedView == TrackerView.Lookup)
    {
        <LiveLookup GameRoot="@_connection.Game?.GameRoot" />
    }
    else
    {
        <ArchiveView GameRoot="@_connection.Game?.GameRoot"
                     CurrentStatistics="@_connection.CurrentState?.AttemptStatistics" />
    }

</main>
