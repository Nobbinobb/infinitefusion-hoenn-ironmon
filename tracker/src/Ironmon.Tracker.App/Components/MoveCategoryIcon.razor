@using Ironmon.Tracker.Protocol

<span class="@GetCssClass()" role="img" aria-label="@GetLabel()" title="@GetLabel()">
    @if (Category == MoveCategory.Physical)
    {
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 1.5 14.2 6.8 19.5 4.5 17.2 9.8 22.5 12l-5.3 2.2 2.3 5.3-5.3-2.3-2.2 5.3-2.2-5.3-5.3 2.3 2.3-5.3L1.5 12l5.3-2.2-2.3-5.3 5.3 2.3L12 1.5Z" />
            <circle cx="12" cy="12" r="2.6" class="icon-cutout" />
        </svg>
    }
    else if (Category == MoveCategory.Special)
    {
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" class="icon-stroke" />
            <circle cx="12" cy="12" r="5" class="icon-stroke" />
            <circle cx="12" cy="12" r="1.8" />
        </svg>
    }
    else if (Category == MoveCategory.Status)
    {
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m12 2 1.6 6.4L20 10l-6.4 1.6L12 18l-1.6-6.4L4 10l6.4-1.6L12 2Z" />
            <path d="m18.5 15 .7 2.8 2.8.7-2.8.7-.7 2.8-.7-2.8-2.8-.7 2.8-.7.7-2.8Z" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.7 8.8A2.5 2.5 0 0 1 12.2 6c1.6 0 2.8.9 2.8 2.4 0 2.4-3 2.5-3 4.7" class="icon-stroke" />
            <circle cx="12" cy="17.5" r="1.2" />
        </svg>
    }
</span>
