<div class="enemy-stat-grid" aria-label="Enemy stat annotations">
    @foreach ((string Name, EnemyStat Stat) stat in _stats)
    {
        <div class="enemy-stat-row">
            <span>@stat.Name</span>
            @if (Enemy is null)
            {
                <button type="button" disabled aria-label="@stat.Name annotation unavailable">&nbsp;</button>
            }
            else
            {
                <button class="@GetAnnotationClass(stat.Stat)"
                        type="button"
                        aria-label="@stat.Name annotation: @GetAnnotationText(stat.Stat)"
                        @onclick="() => CycleAnnotation(stat.Stat, true)"
                        @oncontextmenu="() => CycleAnnotation(stat.Stat, false)"
                        @oncontextmenu:preventDefault>
                    @GetAnnotationSymbol(stat.Stat)
                </button>
            }
        </div>
    }
</div>
