<section class="tracker-settings diagnostic-access" aria-label="@Text["Access.Page.Title"]">
    <header class="settings-heading">
        <div>
            <p class="card-kicker">@Text["Access.Page.Kicker"]</p>
            <h2>@Text["Access.Page.Title"]</h2>
        </div>
    </header>

    <div class="access-state @GetStateClass()" role="status">
        <strong>@GetStateHeading()</strong>
        <span>@GetStateDescription()</span>
    </div>

    @if (_snapshot.State != DiagnosticAccessState.DeveloperOverride)
    {
        <div class="access-input">
            <label for="diagnostic-access-token">@Text["Access.Input.Paste"]</label>
            <textarea id="diagnostic-access-token" value="@_token" @oninput="UpdateToken" rows="4" maxlength="@DiagnosticAccessTokenConstants.MaximumTokenLength" placeholder="@Text["Access.Input.Placeholder"]"></textarea>
            <div class="access-input-actions">
                <label class="access-file-button">
                    @Text["Access.Input.ImportFile"]
                    <InputFile OnChange="ImportTokenFileAsync" accept=".ironmon-access" />
                </label>
                <button type="button" class="access-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_token))" @onclick="ActivateAsync">@Text["Access.Input.Activate"]</button>
            </div>
            @if (_snapshot.State == DiagnosticAccessState.Active && !string.IsNullOrWhiteSpace(_token))
            {
                <p class="access-warning">@Text["Access.Input.ReplacementWarning"]</p>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <p class="access-message @(_operationSucceeded ? "success" : "error")" role="status">@_operationMessage</p>
    }

    @if (_snapshot.Grant is not null)
    {
        <dl class="access-details">
            <div><dt>@Text["Access.Details.Note"]</dt><dd>@(_snapshot.Grant.Note ?? Text["Access.Details.NoNote"])</dd></div>
            <div><dt>@Text["Access.Details.Expiration"]</dt><dd>@FormatExpiration(_snapshot.Grant)</dd></div>
            <div><dt>@Text["Access.Details.TokenId"]</dt><dd><code>@_snapshot.Grant.TokenId</code></dd></div>
            <div><dt>@Text["Access.Details.KeyId"]</dt><dd><code>@_snapshot.Grant.KeyId</code></dd></div>
        </dl>

        <details class="access-grants">
            <summary>@Text["Access.Grants.Direct"]</summary>
            <div class="access-grants-content">
                <div class="access-capabilities">
                    @foreach (string capability in _snapshot.Grant.DirectCapabilities)
                    {
                        <span>@GetCapabilityName(capability)</span>
                    }
                </div>
                @if (IncludedCapabilities.Count > 0)
                {
                    <h3>@Text["Access.Grants.Included"]</h3>
                    <div class="access-capabilities included">
                        @foreach (string capability in IncludedCapabilities)
                        {
                            <span>@GetCapabilityName(capability)</span>
                        }
                    </div>
                }
            </div>
        </details>
    }
    else if (_snapshot.State == DiagnosticAccessState.DeveloperOverride)
    {
        <details class="access-grants">
            <summary>@Text["Access.Grants.Developer"]</summary>
            <div class="access-grants-content">
                <div class="access-capabilities">
                    @foreach (string capability in _snapshot.EffectiveCapabilities)
                    {
                        <span>@GetCapabilityName(capability)</span>
                    }
                </div>
            </div>
        </details>
    }

    @if (_snapshot.UnknownCapabilities.Count > 0)
    {
        <section class="access-unknown">
            <h3>@Text["Access.Grants.Unknown"]</h3>
            <p>@Text["Access.Grants.UnknownDescription"]</p>
            <div class="access-capabilities unknown">
                @foreach (string capability in _snapshot.UnknownCapabilities)
                {
                    <code>@capability</code>
                }
            </div>
        </section>
    }

    @if (_snapshot.State is not DiagnosticAccessState.None and not DiagnosticAccessState.DeveloperOverride)
    {
        <button type="button" class="access-remove" disabled="@_busy" @onclick="RemoveAccess">@Text["Access.Remove.Button"]</button>
    }
</section>
