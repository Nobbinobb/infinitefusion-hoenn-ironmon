<section class="diagnostic-tools" aria-label="@Text["Diagnostics.Page.Title"]">
    <nav class="obsidian diagnostic-tool-tabs" role="tablist" aria-label="@Text["Diagnostics.Page.Tabs"]">
        <button type="button"
                class="@GetTabClass(false)"
                role="tab"
                aria-selected="@(!_toolsSelected)"
                @onclick="ShowAccess">
            <ObsidianIcon Kind="ObsidianIconKind.Key" />@Text["Diagnostics.Page.Access"]
        </button>
        @if (ToolsAvailable)
        {
            <button type="button"
                    class="@GetTabClass(true)"
                    role="tab"
                    aria-selected="@_toolsSelected"
                    @onclick="ShowTools">
                <ObsidianIcon Kind="ObsidianIconKind.Wrench" />@Text["Diagnostics.Page.Tools"]
            </button>
        }
    </nav>

    @if (_toolsSelected && ToolsAvailable)
    {
        <DebugInspector Player="@Player" Enemies="@Enemies" GameRoot="@GameRoot" />
    }
    else
    {
        <DiagnosticAccessPage />
    }
</section>
