<article class="debug-overview" aria-label="Inspected Pokemon overview">
    <div class="card-heading action-heading">
        <div class="sprite-placeholder live" aria-hidden="true">
            @if (_spriteSource is not null)
            {
                <img src="@_spriteSource" alt="" />
            }
            else
            {
                <span>?</span>
            }
        </div>
        <div class="identity-placeholder">
            <p class="card-kicker">@(Pokemon.Fusion ? "FUSION" : "NORMAL POKEMON")</p>
            <h2 class="identity-name"><span>@Pokemon.Nickname</span><GenderIcon Gender="@Pokemon.Gender" /><small>Lv. @Pokemon.Level</small></h2>
            @if (HasDistinctNickname())
            {
                <p class="debug-species-name">@Pokemon.SpeciesName</p>
            }
        </div>
        <div class="identity-actions">
            <span>Item <strong>@(Pokemon.HeldItemName ?? "None")</strong></span>
            <span>Form <strong>@GetFormText()</strong></span>
        </div>
    </div>

    <section class="debug-data-section">
        <p class="section-label">IDENTITY</p>
        <dl class="debug-data-grid">
            <div><dt>Pokemon ID</dt><dd>@Pokemon.PokemonId</dd></div>
            <div><dt>Species ID</dt><dd>@Pokemon.SpeciesId</dd></div>
            <div><dt>Ability slot</dt><dd>@Pokemon.ActiveAbilitySlot (@Pokemon.ActiveAbilityIndex)</dd></div>
            <div><dt>Ability</dt><dd>@Pokemon.ActiveAbilityName · @Pokemon.ActiveAbilityId</dd></div>
        </dl>
    </section>

    @if (Pokemon.Body is not null && Pokemon.Head is not null)
    {
        <section class="debug-data-section">
            <p class="section-label">DISPLAYED COMPONENTS</p>
            <dl class="debug-data-grid">
                <div><dt>Body</dt><dd>@Pokemon.Body.SpeciesName · @Pokemon.Body.SpeciesId</dd></div>
                <div><dt>Head</dt><dd>@Pokemon.Head.SpeciesName · @Pokemon.Head.SpeciesId</dd></div>
            </dl>
        </section>
    }

    <section class="debug-data-section">
        <p class="section-label">ABILITY GENERATOR</p>
        <dl class="debug-data-grid">
            <div><dt>Run seed</dt><dd>@(Pokemon.Generator.RunSeed?.ToString() ?? "None")</dd></div>
            <div><dt>Schema</dt><dd>@Pokemon.Generator.SchemaVersion</dd></div>
            <div><dt>Pool rules</dt><dd>@Pokemon.Generator.PoolRulesVersion</dd></div>
            <div><dt>Pool size</dt><dd>@Pokemon.Generator.PoolSize</dd></div>
            <div class="wide"><dt>Fingerprint</dt><dd>@Pokemon.Generator.PoolFingerprint</dd></div>
        </dl>
    </section>
</article>
