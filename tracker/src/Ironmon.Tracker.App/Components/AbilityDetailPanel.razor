<div class="detail-overlay" role="presentation" @onclick="Close">
    <section class="detail-panel" role="dialog" aria-modal="true" aria-labelledby="ability-detail-title" @onclick:stopPropagation>
        <header class="detail-panel-header">
            <div>
                <p class="card-kicker">ABILITY INFORMATION</p>
                <h2 id="ability-detail-title">@Ability.Name</h2>
            </div>
            <button class="detail-close" type="button" aria-label="Close ability information" @onclick="Close">×</button>
        </header>
        <p class="detail-description">@GetDescription()</p>
    </section>
</div>
