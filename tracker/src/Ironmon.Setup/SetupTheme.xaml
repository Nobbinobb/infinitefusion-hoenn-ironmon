<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SetupBackground" Color="#090D12" />
    <SolidColorBrush x:Key="SetupForeground" Color="#E7EDF7" />
    <SolidColorBrush x:Key="SetupMuted" Color="#9EACBF" />
    <SolidColorBrush x:Key="SetupBorder" Color="#2A3544" />
    <SolidColorBrush x:Key="SetupAccent" Color="#B0A3FF" />
    <SolidColorBrush x:Key="SetupWarning" Color="#E3B96C" />
    <SolidColorBrush x:Key="SetupSelected" Color="#79CAA0" />
    <SolidColorBrush x:Key="SetupNotSelected" Color="#E39B9B" />
    <LinearGradientBrush x:Key="SetupSurface" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B2330" Offset="0" />
        <GradientStop Color="#11161E" Offset="0.85" />
    </LinearGradientBrush>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SetupForeground}" />
        <Setter Property="Background" Value="#151D29" />
        <Setter Property="BorderBrush" Value="#354257" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True"><Setter TargetName="Surface" Property="Background" Value="#28273B" /><Setter TargetName="Surface" Property="BorderBrush" Value="#8176B5" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1D2031" /><Setter TargetName="Surface" Property="BorderBrush" Value="#8176B5" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SetupAccent}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#353047" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource SetupForeground}" />
        <Setter Property="Background" Value="{StaticResource SetupBackground}" />
        <Setter Property="CaretBrush" Value="{StaticResource SetupForeground}" />
        <Setter Property="SelectionBrush" Value="#8176B5" />
        <Setter Property="BorderBrush" Value="#354257" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SetupAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SetupForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" CornerRadius="4" Background="#090D12" BorderBrush="#58667D" BorderThickness="1">
                            <Path x:Name="Check" Data="M 3,8 L 7,12 L 14,4" Stroke="#EEEAFA" StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#55457B" /><Setter TargetName="Box" Property="BorderBrush" Value="#B0A3FF" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#EEEAFA" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B0A3FF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SetupForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" BorderBrush="#354257" Background="#11161E" Padding="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Ring" Width="18" Height="18" BorderThickness="1" BorderBrush="#58667D" CornerRadius="9" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <Ellipse x:Name="Dot" Fill="#B0A3FF" Margin="4" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1D2031" /><Setter TargetName="Surface" Property="BorderBrush" Value="#8176B5" /><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B0A3FF" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#B0A3FF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="#28313F" ClipToBounds="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#B0A3FF" CornerRadius="2" />
                        <Border x:Name="Activity" Width="120" HorizontalAlignment="Left" Background="#B0A3FF" CornerRadius="2" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform x:Name="ActivityPosition" /></Border.RenderTransform></Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Activity" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions><BeginStoryboard x:Name="ActivityAnimation"><Storyboard><DoubleAnimation Storyboard.TargetName="ActivityPosition" Storyboard.TargetProperty="X" From="-120" To="680" Duration="0:0:1.8" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="ActivityAnimation" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
