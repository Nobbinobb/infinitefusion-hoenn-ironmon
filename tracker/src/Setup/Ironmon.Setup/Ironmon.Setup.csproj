<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ironmon Setup</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- .NET 11 WPF mixed-mode assemblies must be loaded from disk. See dotnet/wpf#11842. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ironmon.Setup.Tests" />
    <ProjectReference Include="../Ironmon.Setup.Core/Ironmon.Setup.Core.csproj" />
  </ItemGroup>
  <Import Project="../../../UpdaterNotices.targets" />
</Project>
