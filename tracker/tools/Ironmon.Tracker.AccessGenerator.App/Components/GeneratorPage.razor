@implements IDisposable
@inject DiagnosticAccessTokenGenerator TokenGenerator
@inject GeneratorFileService FileService

<main class="generator-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">@Text["Generator.Header.Release", AppInfo.Current.VersionString]</p>
            <h1>@Text["Generator.Header.Title"]</h1>
            <p class="subtitle">@Text["Generator.Header.Description"]</p>
        </div>
        <span class="header-context"><ObsidianIcon Kind="ObsidianIconKind.ShieldCheck" />@Text["Generator.Header.Context"]</span>
    </header>

    <section class="panel signing-key" aria-label="@Text["Generator.SigningKey.Title"]">
        <span class="key-icon"><ObsidianIcon Kind="ObsidianIconKind.Key" /></span>
        <div class="key-info">
            <strong>@(_signingKey?.SourceName ?? Text["Generator.SigningKey.Empty"])</strong>
            <p>@(_signingKey is null ? Text["Generator.SigningKey.Description"] : Text["Generator.SigningKey.KeyId"] + " · " + _signingKey.KeyId)</p>
        </div>
        @if (_signingKey is not null)
        {
            <span class="key-status"><ObsidianIcon Kind="ObsidianIconKind.Check" />@Text["Generator.SigningKey.Loaded"]</span>
        }
        <button disabled="@_loadingKey" @onclick="LoadSigningKeyAsync">@Text[_signingKey is null ? "Generator.SigningKey.Choose" : "Generator.SigningKey.Change"]<ObsidianIcon Kind="ObsidianIconKind.FolderOpen" /></button>
    </section>

    <div class="generator-workspace">
        <section class="panel permissions-panel">
            <h2 class="section-heading"><ObsidianIcon Kind="ObsidianIconKind.Layers" />@Text["Generator.Capabilities.Title"]</h2>
            <div class="preset">
                <label class="field">@Text["Generator.Details.Preset"]
                    <select @bind="_presetId" @bind:after="ApplySelectedPreset">
                        <option value="">@Text["Generator.Details.CustomSelection"]</option>
                        @foreach (DiagnosticAccessPreset preset in DiagnosticAccessPresetCatalog.All)
                        {
                            <option value="@preset.Id">@Text[GeneratorLocalizationKeys.GetPresetName(preset.Id)]</option>
                        }
                    </select>
                </label>
                <p class="preset-description">@(string.IsNullOrWhiteSpace(_presetDescription) ? Text["Generator.Details.CustomDescription"] : _presetDescription)</p>
            </div>
            <GeneratorPermissionEditor Selection="_selection" Changed="change => SetCapability(change.Capability, change.Selected)" />
        </section>

        <aside class="generator-sidebar">
            <section class="panel">
                <h2 class="section-heading"><ObsidianIcon Kind="ObsidianIconKind.Key" />@Text["Generator.Details.Title"]</h2>
                <label class="field">@Text["Generator.Details.SupportNote"] · @Text["Generator.Common.Optional"]
                    <textarea value="@_note" @oninput="UpdateNote" maxlength="@DiagnosticAccessTokenConstants.MaximumNoteLength" placeholder="@Text["Generator.Details.SupportNotePlaceholder"]" rows="2"></textarea>
                </label>
                <label class="lifetime">@Text["Generator.Details.LifetimeAccess"]<input type="checkbox" role="switch" checked="@_neverExpires" @onchange="SetNeverExpires" /></label>
                <label class="field">@Text["Generator.Details.ExpiresAt"]
                    <input type="datetime-local" step="1" value="@_expirationLocal" @oninput="UpdateExpiration" disabled="@_neverExpires" />
                </label>
                <p class="help">@Text[_neverExpires ? "Generator.Details.LifetimeHint" : "Generator.Details.ExpirationHint"]</p>
            </section>
            <section class="panel">
                <h2 class="section-heading"><ObsidianIcon Kind="ObsidianIconKind.ShieldCheck" />@Text["Generator.Review.Title"]</h2>
                <div class="summary-counts">
                    <div><small>@Text["Generator.Review.DirectGrantCount"]</small><strong>@_selection.DirectCapabilities.Count</strong></div>
                    <div><small>@Text["Generator.Review.EffectiveGrantCount"]</small><strong>@_selection.EffectiveCapabilities.Count</strong></div>
                </div>
                <dl class="summary-details">
                    <div><dt>@Text["Generator.Review.Included"]</dt><dd>@Text["Generator.Review.GrantCount", _selection.EffectiveCapabilities.Count - _selection.DirectCapabilities.Count]</dd></div>
                    <div><dt>@Text["Generator.Review.Expiration"]</dt><dd>@GetExpirationSummary()</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_errorMessage) && !_showReview && !_showResult)
                {
                    <p class="message error" role="alert">@_errorMessage</p>
                }
                <button class="primary review-button" @onclick="ReviewToken">@Text["Generator.Review.Open"]<ObsidianIcon Kind="ObsidianIconKind.ArrowRight" /></button>
            </section>
        </aside>
    </div>
    <footer><ObsidianIcon Kind="ObsidianIconKind.Lock" />@Text["Generator.Footer.PrivateKey"]</footer>
</main>

@if (_showReview)
{
    <GeneratorDialog Title="@Text["Generator.Review.DialogTitle"]" Eyebrow="@Text["Generator.Review.TokenContext"]" Closed="CloseDialogs">
        <dl class="review-metadata">
            <div><dt>@Text["Generator.Review.KeyId"]</dt><dd>@_signingKey?.KeyId</dd></div>
            <div><dt>@Text["Generator.Review.TokenId"]</dt><dd class="token-id">@_tokenId</dd></div>
            <div><dt>@Text["Generator.Review.Expiration"]</dt><dd>@GetExpirationSummary()</dd></div>
            @if (!string.IsNullOrWhiteSpace(_note)) { <div><dt>@Text["Generator.Details.SupportNote"]</dt><dd>@NormalizeNote()</dd></div> }
        </dl>
        <div class="review-tabs">
            <button aria-pressed="@(!_reviewEffective ? "true" : "false")" @onclick="() => _reviewEffective = false">@Text["Generator.Review.DirectGrants"] · @_selection.DirectCapabilities.Count</button>
            <button aria-pressed="@(_reviewEffective ? "true" : "false")" @onclick="() => _reviewEffective = true">@Text["Generator.Review.EffectiveGrants"] · @_selection.EffectiveCapabilities.Count</button>
        </div>
        <GeneratorGrantList Selection="_selection" Capabilities="@(_reviewEffective ? _selection.EffectiveCapabilities : _selection.DirectCapabilities)" />
        @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <p class="message error" role="alert">@_errorMessage</p> }
        <div class="dialog-actions"><button @onclick="CloseDialogs">@Text["Generator.Review.Back"]</button><button class="primary" @onclick="GenerateToken"><ObsidianIcon Kind="ObsidianIconKind.Key" />@Text["Generator.Review.Generate"]</button></div>
    </GeneratorDialog>
}
@if (_showResult && _result is not null)
{
    <GeneratorDialog Title="@Text["Generator.Result.Title"]" Eyebrow="@Text["Generator.Review.TokenContext"]" Closed="CloseDialogs">
        <p class="muted">@Text["Generator.Result.Description"]</p>
        <textarea class="token-output" aria-label="@Text["Generator.Result.Title"]" readonly rows="5">@_result.Token</textarea>
        <p class="help">@Text["Generator.Result.Summary", _result.DirectCapabilities.Count, _result.EffectiveCapabilities.Count] · @GetExpirationSummary()</p>
        <div class="dialog-actions"><button class="primary" @onclick="CopyTokenAsync"><ObsidianIcon Kind="ObsidianIconKind.Copy" />@Text["Generator.Result.Copy"]</button><button @onclick="SaveTokenAsync"><ObsidianIcon Kind="ObsidianIconKind.FileDown" />@Text["Generator.Result.Save"]</button></div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <p class="message error" role="alert">@_errorMessage</p> }
        @if (!string.IsNullOrWhiteSpace(_resultMessage)) { <p class="message success" role="status">@_resultMessage</p> }
        <div class="dialog-actions"><button class="quiet" @onclick="StartNewToken">@Text["Generator.Result.CreateAnother"]<ObsidianIcon Kind="ObsidianIconKind.ArrowRight" /></button></div>
    </GeneratorDialog>
}
