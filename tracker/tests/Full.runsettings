<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Category!=Network</TestCaseFilter>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <xUnit>
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
  </xUnit>
</RunSettings>